    {
      "id": "light-03",
      "title": "光的反射",
      "level": "基础",
      "definition": "光射到物体表面后返回原介质的现象叫反射。反射光线、入射光线和法线在同一平面内；反射角等于入射角，两角都从法线量起。",
      "meaning": "作图时先找法线，再分别量入射角与反射角，角度不从镜面量起。反射定律可用角度读数检查：入射角变化多少，反射角就变化多少；反射线和镜面之间的夹角则与反射角互为余角。漫反射与镜面反射都遵循反射定律，只是表面情况不同。",
      "symbols": {
        "i": {
          "desc": "入射角，按度数记录",
          "unit": "1"
        },
        "r": {
          "desc": "反射角，按度数记录",
          "unit": "1"
        },
        "alpha": {
          "desc": "反射光线与镜面的夹角，按度数记录",
          "unit": "1"
        }
      },
      "scenarios": {
        "入射角30度": {
          "i": 30,
          "r": 30,
          "alpha": 60
        },
        "入射角60度": {
          "i": 60,
          "r": 60,
          "alpha": 30
        }
      },
      "formulas": [
        {
          "name": "反射定律的角度关系",
          "expr": "r = i",
          "when": "入射角和反射角均从法线量起；角度使用度数，且反射发生在同一介质侧。",
          "checks": [
            {
              "type": "numeric",
              "scenario": "入射角30度",
              "expr": "i",
              "ref": 30,
              "note": "入射角为 30°，反射角也为 30°。"
            },
            {
              "type": "numeric",
              "scenario": "入射角60度",
              "expr": "i",
              "ref": 60,
              "note": "入射角为 60°，反射角也为 60°。"
            },
            {
              "type": "direction",
              "scenario": "入射角30度",
              "var": "i",
              "lo": 10,
              "hi": 80,
              "expr": "i",
              "expect": "up",
              "note": "入射角增加时反射角等量增加。"
            },
            {
              "type": "scan",
              "scenario": "入射角30度",
              "var": "i",
              "lo": 10,
              "hi": 80,
              "note": "扫描常见的正入射角范围，反射角始终有限并与入射角相等。"
            },
            {
              "type": "consistency",
              "scenario": "入射角30度",
              "expr": "r",
              "with": "light-03|反射线与镜面的夹角",
              "with_expr": "90-alpha",
              "target": "反射角",
              "note": "由反射定律得到反射角，再用镜面与法线垂直的几何关系从余角测回。"
            }
          ]
        },
        {
          "name": "反射线与镜面的夹角",
          "expr": "alpha = 90-r",
          "when": "alpha 是反射线与镜面的夹角，r 是反射角；法线与镜面互相垂直。",
          "checks": [
            {
              "type": "numeric",
              "scenario": "入射角30度",
              "expr": "90-r",
              "ref": 60,
              "note": "反射角 30°，反射线与镜面的夹角为 60°。"
            },
            {
              "type": "numeric",
              "scenario": "入射角60度",
              "expr": "90-r",
              "ref": 30,
              "note": "反射角 60°，对应镜面夹角为 30°。"
            },
            {
              "type": "direction",
              "scenario": "入射角30度",
              "var": "r",
              "lo": 10,
              "hi": 80,
              "expr": "90-r",
              "expect": "down",
              "note": "反射角增大时，与镜面的夹角减小。"
            },
            {
              "type": "scan",
              "scenario": "入射角30度",
              "var": "r",
              "lo": 10,
              "hi": 80,
              "note": "扫描反射角范围，余角不越出 0° 至 90°。"
            }
          ]
        }
      ],
      "derivation": [
        "过入射点作垂直于反射面的法线，明确角度的共同基准。",
        "反射定律给出反射角 r 与入射角 i 相等。",
