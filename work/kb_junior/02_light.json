{
  "chapter": "光现象",
  "order": 2,
  "intro": "按苏科版2024目录将光的色彩、直线传播、平面镜和光的反射分为四个可查知识点；拓展关系明确标注，不替代教材实验结论。",
  "points": [
    {
      "id": "light-04",
      "title": "光的色彩",
      "level": "拓展",
      "definition": "白光由多种色光组成；不同色光在真空中的波速相同，但频率和波长不同。按本知识点的拓展关系，光速、频率与波长可互相换算，色散现象则用来观察白光分解出的色光。",
      "meaning": "教材重点是观察色散、认识不同色光及其混合现象；颜色不能用亮度替代。为把观察与可测量量联系起来，这里补充真空电磁波的波速关系：固定光速时，波长越长，频率越低。该换算属于拓展工具，不代替色散实验，也不意味着所有介质中的光速都相同。",
      "symbols": {
        "f": {
          "desc": "光波频率",
          "unit": "Hz"
        },
        "lambda": {
          "desc": "光波波长",
          "unit": "m"
        },
        "c": {
          "desc": "真空中的光速",
          "unit": "m/s"
        },
        "s": {
          "desc": "真空中光传播路程",
          "unit": "m"
        },
        "t": {
          "desc": "传播时间",
          "unit": "s"
        }
      },
      "scenarios": {
        "红光近似值": {
          "f": 400000000000000,
          "lambda": 7.5e-7,
          "c": 300000000,
          "s": 300,
          "t": 0.000001
        },
        "紫光近似值": {
          "f": 750000000000000,
          "lambda": 4e-7,
          "c": 300000000,
          "s": 600,
          "t": 0.000002
        }
      },
      "formulas": [
        {
          "name": "由真空光速和波长求频率",
          "expr": "f = c/lambda",
          "when": "用于真空或可近似看作真空的光传播；光速 c、波长 lambda 使用 m/s、m。此关系用于色光的定量拓展，不是判断颜色的唯一依据。",
          "checks": [
            {
              "type": "numeric",
              "scenario": "红光近似值",
              "expr": "c/lambda",
              "ref": 400000000000000,
              "note": "约 3.0×10^8 m/s ÷ 7.5×10^-7 m = 4.0×10^14 Hz。"
            },
            {
              "type": "numeric",
              "scenario": "紫光近似值",
              "expr": "c/lambda",
              "ref": 750000000000000,
              "note": "约 3.0×10^8 m/s ÷ 4.0×10^-7 m = 7.5×10^14 Hz。"
            },
            {
              "type": "direction",
              "scenario": "红光近似值",
              "var": "lambda",
              "lo": 4e-7,
              "hi": 8e-7,
              "expr": "c/lambda",
              "expect": "down",
              "note": "在光速不变时，波长增大，频率减小。"
            },
            {
              "type": "scan",
              "scenario": "红光近似值",
              "var": "lambda",
              "lo": 4e-7,
              "hi": 8e-7,
              "note": "扫描可见光附近正波长，频率保持为有限正值。"
            },
            {
              "type": "consistency",
              "scenario": "红光近似值",
              "expr": "lambda*f",
              "with": "light-01|由传播路程和时间求光速",
              "with_expr": "s/t",
              "target": "真空光速",
              "note": "以波长和频率求波速，再用传播路程除以时间测得波速，二者应相符。"
            }
          ]
        }
      ],
      "derivation": [
        "波在一个周期内传播一个波长，因此波速等于波长乘以每秒振动次数。",
        "频率关系 c=lambda*f 两边同除以波长，得到 f=c/lambda。",
        "代入前统一单位：波长用 m、频率用 Hz，乘积的单位为 m/s。"
      ],
      "errors": [
        {
          "wrong": "把频率误算为波速乘波长，混淆了相除关系。",
          "wrong_expr": "f = c/(2*lambda)",
          "why": "真空光速和波长确定后，频率应为 c/lambda；多除以 2 会使结果恰好减半。",
          "caught_by": "数值代入",
          "trap_test": {
            "scenario": "红光近似值",
            "expr": "c/(2*lambda)",
            "ref": 400000000000000
          }
        },
        {
          "wrong": "认为白光本身只有一种颜色，或把色光混合与颜料混合规律混为一谈。",
          "why": "棱镜色散可观察到白光分解出的多种色光；色光的叠加与颜料混合不是同一过程。",
          "caught_by": "人工审核"
        }
      ],
      "example": {
        "stem": "某单色光波长约为 6.0×10^-7 m，取真空光速 3.0×10^8 m/s，估算其频率。",
        "solution": [
          "辨认所求量是频率，使用 f=c/lambda。",
          "代入 f=3.0×10^8÷6.0×10^-7=5.0×10^14 Hz。"
        ],
        "answer": "频率约为 5.0×10^14 Hz。"
      },
      "prereq": [],
