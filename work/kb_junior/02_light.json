    {
      "id": "light-01",
      "title": "光的直线传播",
      "level": "基础",
      "definition": "光在同种均匀介质中沿直线传播；从一种介质进入另一种介质时，传播方向可能改变。真空中的光速约为每秒三亿米，空气中的光速可近似取这一数值。",
      "meaning": "影子的形成、小孔成像和日食月食都能用光沿直线传播解释。计算传播距离时，要区分单程和往返路程，并让速度、时间和距离采用相容单位。光速关系只能计算传播过程，不能单独决定反射或折射方向。",
      "symbols": {
        "s": {
          "desc": "光传播的路程",
          "unit": "m"
        },
        "c": {
          "desc": "光传播速度，空气中近似取真空光速",
          "unit": "m/s"
        },
        "t": {
          "desc": "光传播所用时间",
          "unit": "s"
        }
      },
      "scenarios": {
        "光传播1微秒": {
          "s": 300,
          "c": 300000000,
          "t": 0.000001
        },
        "光传播2微秒": {
          "s": 600,
          "c": 300000000,
          "t": 0.000002
        }
      },
      "formulas": [
        {
          "name": "由光速和时间求传播路程",
          "expr": "s = c*t",
          "when": "光在同一均匀介质中近似匀速传播，t 使用秒。",
          "checks": [
            {
              "type": "numeric",
              "scenario": "光传播1微秒",
              "expr": "c*t",
              "ref": 300,
              "note": "3.0×10^8 m/s × 10^-6 s = 300 m。"
            },
            {
              "type": "numeric",
              "scenario": "光传播2微秒",
              "expr": "c*t",
              "ref": 600,
              "note": "时间加倍，传播路程加倍。"
            },
            {
              "type": "direction",
              "scenario": "光传播1微秒",
              "var": "t",
              "lo": 0.000001,
              "hi": 0.00001,
              "expr": "c*t",
              "expect": "up",
              "note": "光速固定时，传播时间越长，路程越大。"
            },
            {
              "type": "scan",
              "scenario": "光传播1微秒",
              "var": "t",
              "lo": 0.000001,
              "hi": 0.00001,
              "note": "扫描正时间范围，检查传播路程随参数变化稳定。"
            }
          ]
        },
        {
          "name": "由传播路程和时间求光速",
          "expr": "c = s/t",
          "when": "s 与 t 必须描述同一段光传播过程。",
          "checks": [
            {
              "type": "numeric",
              "scenario": "光传播1微秒",
              "expr": "s/t",
              "ref": 300000000,
              "note": "300 m ÷ 0.000001 s = 3.0×10^8 m/s。"
            },
            {
              "type": "numeric",
              "scenario": "光传播2微秒",
              "expr": "s/t",
              "ref": 300000000,
              "note": "600 m ÷ 0.000002 s 仍约为 3.0×10^8 m/s。"
            },
            {
              "type": "consistency",
              "scenario": "光传播1微秒",
              "expr": "s/t",
              "with": "light-01|由光速和时间求传播路程",
              "with_expr": "c*t/t",
              "target": "同一段光传播的速度",
              "note": "以已知路程计时反求速度，再以光速和时间预测路程复核同一传播过程。"
            }
          ]
        }
      ],
      "derivation": [
        "光沿直线传播时，路程可由轨迹长度确定；在同种均匀介质中传播速度近似不变。",
        "速度定义为单位时间通过的路程，因此路程等于速度乘时间，速度也可由路程除以时间求出。",
        "统一使用 m/s、s 和 m；若描述的是反射测距往返过程，还要把总路程与单程路程区分。"
      ],
      "errors": [
        {
          "wrong": "把单程传播误写成往返路程，平白多乘 2。",
          "wrong_expr": "s = 2*c*t",
          "why": "题目若只描述光从发出到到达一次，路程就是 c*t；额外乘 2 会把单程误算成往返。",
          "caught_by": "数值代入",
          "trap_test": {
            "scenario": "光传播1微秒",
            "expr": "2*c*t",
            "ref": 300
          }
        },
        {
          "wrong": "认为光在任何介质交界处都不会改变传播方向。",
          "why": "光斜射入另一种介质时可能发生折射；直线传播规律只适用于同种均匀介质。",
          "caught_by": "人工审核"
        }
      ],
      "example": {
        "stem": "空气中一束光传播 2 微秒，按光速约 3.0×10^8 m/s 估算路程。",
        "solution": [
          "先换算时间：2 微秒 = 0.000002 s。",
          "使用 s=ct，得到 3.0×10^8×0.000002=600 m。"
        ],
        "answer": "约 600 m。"
      },
      "prereq": [],
      "next": [
