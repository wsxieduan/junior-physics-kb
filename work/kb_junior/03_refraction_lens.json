{
  "chapter": "光的折射 透镜",
  "order": 3,
  "intro": "按苏科版2024目录将折射、透镜、凸透镜成像规律、透镜应用及不可见光分别整理；明确标注的定量光学关系属于拓展内容。",
  "points": [
    {
      "id": "lens-03",
      "title": "光的折射",
      "level": "拓展",
      "definition": "光从一种介质斜射入另一种介质时，传播方向通常发生改变，这种现象叫折射；垂直界面入射时方向不变。不同介质中的光速不同，折射方向与介质的光学性质有关。",
      "meaning": "观察折射时要先确定界面、法线和入射介质，再判断光线偏向法线还是偏离法线；不能照搬反射角等于入射角。作为定量拓展，可用折射率 n=c/v 表示真空光速与介质中光速之比，但这不是初中折射作图规则的替代品。",
      "symbols": {
        "n": {
          "desc": "介质的折射率，表示光速比值",
          "unit": "1"
        },
        "c": {
          "desc": "真空中的光速",
          "unit": "m/s"
        },
        "v": {
          "desc": "光在介质中的传播速度",
          "unit": "m/s"
        },
        "s": {
          "desc": "真空中光传播路程",
          "unit": "m"
        },
        "t": {
          "desc": "真空中光传播时间",
          "unit": "s"
        }
      },
      "scenarios": {
        "水中的光": {
          "n": 1.333333333333,
          "c": 300000000,
          "v": 225000000,
          "s": 300,
          "t": 0.000001
        },
        "玻璃中的光": {
          "n": 1.5,
          "c": 300000000,
          "v": 200000000,
          "s": 600,
          "t": 0.000002
        }
      },
      "formulas": [
        {
          "name": "折射率与介质中光速的关系",
          "expr": "n = c/v",
          "when": "本式为光速比值的定量拓展；c 是真空光速，v 是同一介质中的光速，二者单位相同。",
          "checks": [
            {
              "type": "numeric",
              "scenario": "水中的光",
              "expr": "c/v",
              "ref": 1.333333333333,
              "note": "以近似光速 3.0×10^8 m/s 和水中光速 2.25×10^8 m/s 估算，n≈1.33。"
            },
            {
              "type": "numeric",
              "scenario": "玻璃中的光",
              "expr": "c/v",
              "ref": 1.5,
              "note": "以玻璃中光速 2.0×10^8 m/s 估算，n≈1.50。"
            },
            {
              "type": "direction",
              "scenario": "水中的光",
              "var": "v",
              "lo": 150000000,
              "hi": 300000000,
              "expr": "c/v",
              "expect": "down",
              "note": "真空光速不变时，介质中的光速越小，折射率越大。"
            },
            {
              "type": "scan",
              "scenario": "水中的光",
              "var": "v",
              "lo": 150000000,
              "hi": 300000000,
              "note": "扫描正的介质光速，折射率保持有限且为正。 "
            },
            {
              "type": "consistency",
              "scenario": "水中的光",
              "expr": "c/v",
              "with": "light-01|由传播路程和时间求光速",
              "with_expr": "(s/t)/v",
              "target": "介质折射率",
              "note": "真空光速既可取近似值，也可由传播距离与时间复算；两种取值代入光速比后应一致。"
            }
          ]
        }
      ],
      "derivation": [
        "折射率定义为真空中的光速与该介质中光速之比。",
        "写出 n=c/v，并确认分子、分母都是速度，所得比值无单位。",
        "介质中光速越小，c/v 越大；该比值不能单独给出任意入射角下的折射角。"
      ],
      "errors": [
        {
          "wrong": "把折射率写成介质光速与真空光速之比。",
          "wrong_expr": "n = 2*v/c",
          "why": "折射率定义中的比值是 c/v；把速度比倒置并多乘系数会导致结果明显不符。",
          "caught_by": "数值代入",
          "trap_test": {
            "scenario": "水中的光",
            "expr": "2*v/c",
            "ref": 1.333333333333
          }
        },
        {
          "wrong": "把反射角等于入射角当作折射规律。",
          "why": "反射和折射是不同现象；折射方向需结合两侧介质和法线判断，不能套用反射定律。",
          "caught_by": "人工审核"
        }
      ],
      "example": {
        "stem": "某介质中光速约为 2.0×10^8 m/s，取真空光速 3.0×10^8 m/s，估算其折射率。",
        "solution": [
          "折射率 n=c/v。",
          "代入 3.0×10^8÷2.0×10^8=1.5。"
        ],
        "answer": "折射率约为 1.5。"
      },
      "prereq": [
        "light-01"
      ],
      "next": [
        "lens-02"
      ],
      "tags": [
        "光的折射",
        "介质",
        "法线",
        "折射率",
        "拓展"
      ]
    },
    {
      "id": "lens-02",
      "title": "透镜",
      "level": "基础",
      "definition": "透镜分为凸透镜和凹透镜。凸透镜对平行于主光轴的光线有会聚作用，凹透镜有发散作用；平行光经凸透镜会聚点到光心的距离称为焦距。",
      "meaning": "辨认透镜时可观察中间和边缘的厚薄，但判断光线作用应以实际光路为准。测凸透镜焦距可让平行光会聚到焦点，再量光心到焦点的距离。焦距是透镜的基本特征，物距与焦距的比较决定后续成像规律。",
      "symbols": {
        "f": {
          "desc": "凸透镜焦距",
          "unit": "m"
        },
        "d": {
          "desc": "光心到焦点的距离",
          "unit": "m"
        },
        "u": {
          "desc": "物距，即物体到凸透镜的距离",
          "unit": "m"
        },
        "v": {
          "desc": "像距，即像到凸透镜的距离",
          "unit": "m"
        },
        "h1": {
          "desc": "物体高度",
          "unit": "m"
        },
        "h2": {
          "desc": "像的高度",
          "unit": "m"
        }
      },
      "scenarios": {
