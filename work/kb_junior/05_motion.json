{
  "chapter": "物体的运动",
  "order": 5,
  "intro": "按苏科版2024目录整理长度与时间测量、速度、直线运动和运动相对性；速度换算与相对运动均注明单位、方向和适用条件。",
  "points": [
    {
      "id": "motion-03",
      "title": "长度与时间的测量",
      "level": "基础",
      "definition": "长度用刻度尺测量，时间可用秒表或计时器测量。读数要包含准确值和估读值，并记录单位；比较不同记录前应把长度换算到同一单位。",
      "meaning": "测量前先看量程、分度值和零刻线，放置刻度尺时让刻度线与被测边平行；读数时视线垂直刻度面。时间测量要明确起止事件并尽量重复测量减小偶然误差。米、厘米和千米之间的换算有固定比例，错误换算会造成数量级偏差。",
      "symbols": {
        "L_m": {
          "desc": "以米记录的长度",
          "unit": "m"
        },
        "L_cm": {
          "desc": "同一长度以厘米记录",
          "unit": "cm"
        },
        "L_km": {
          "desc": "同一长度以千米记录",
          "unit": "km"
        }
      },
      "scenarios": {
        "课桌长度": {
          "L_m": 1.2,
          "L_cm": 120,
          "L_km": 0.0012
        },
        "教室长度": {
          "L_m": 8.5,
          "L_cm": 850,
          "L_km": 0.0085
        }
      },
      "formulas": [
        {
          "name": "米换算为厘米",
          "expr": "L_cm = 100*L_m",
          "when": "同一长度的单位换算，1 m=100 cm。",
          "checks": [
            {
              "type": "numeric",
              "scenario": "课桌长度",
              "expr": "100*L_m",
              "ref": 120,
              "note": "1.2 m 换算为 120 cm。 "
            },
            {
              "type": "numeric",
              "scenario": "教室长度",
              "expr": "100*L_m",
              "ref": 850,
              "note": "8.5 m 换算为 850 cm。 "
            },
            {
              "type": "direction",
              "scenario": "课桌长度",
              "var": "L_m",
              "lo": 0.1,
              "hi": 10,
              "expr": "100*L_m",
              "expect": "up",
              "note": "长度以米表示的数值增加时，厘米数按比例增加。 "
            },
            {
              "type": "scan",
              "scenario": "课桌长度",
              "var": "L_m",
              "lo": 0.01,
              "hi": 100,
              "note": "扫描正长度，单位换算结果保持有限。 "
            },
            {
              "type": "consistency",
              "scenario": "课桌长度",
              "expr": "L_cm/100",
              "with": "motion-03|米换算为千米",
              "with_expr": "L_km*1000",
              "target": "同一长度的米数",
              "note": "通过厘米和千米两条单位换算路径，反算回米后互相核对。 "
            }
          ]
        },
        {
          "name": "米换算为千米",
          "expr": "L_km = L_m/1000",
          "when": "同一长度的单位换算，1 km=1000 m。",
          "checks": [
            {
              "type": "numeric",
              "scenario": "课桌长度",
              "expr": "L_m/1000",
              "ref": 0.0012,
              "note": "1.2 m 换算为 0.0012 km。 "
            },
            {
              "type": "numeric",
              "scenario": "教室长度",
              "expr": "L_m/1000",
              "ref": 0.0085,
              "note": "8.5 m 换算为 0.0085 km。 "
            },
            {
              "type": "direction",
              "scenario": "教室长度",
              "var": "L_m",
              "lo": 0.1,
              "hi": 10,
              "expr": "L_m/1000",
              "expect": "up",
              "note": "米数增加时，千米数也按比例增加。 "
            },
            {
              "type": "scan",
              "scenario": "教室长度",
              "var": "L_m",
              "lo": 0.01,
              "hi": 100,
              "note": "扫描正长度，换算数值保持稳定。 "
            }
          ]
        }
      ],
      "derivation": [
        "测量对象的长度与计时过程要先定义清楚，并选用合适量程的工具。",
        "记录读数时保留单位；将厘米换成米除以 100，将米换成千米除以 1000。",
        "用两种单位换算后再反算，检查数量级与原始测量是否一致。"
      ],
      "errors": [
        {
          "wrong": "把 1 m 误当作 10 cm，导致长度单位换算少一个数量级。",
          "wrong_expr": "L_cm = 10*L_m",
          "why": "1 m=100 cm；课桌长度 1.2 m 应为 120 cm，而不是 12 cm。",
          "caught_by": "数值代入",
          "trap_test": {
            "scenario": "课桌长度",
            "expr": "10*L_m",
            "ref": 120
          }
        },
        {
          "wrong": "读刻度尺时视线倾斜，造成视差并把估读值当作准确值。",
          "why": "视线应垂直刻度面；测量误差需结合分度值和重复测量分析。应记录仪器分度值并按规范重复测量。",
          "caught_by": "人工审核"
        }
      ],
      "example": {
        "stem": "一张桌子的长度测得 1.2 m，分别换算成厘米和千米。",
        "solution": [
          "厘米：1.2×100=120 cm。",
          "千米：1.2÷1000=0.0012 km。"
        ],
        "answer": "120 cm；0.0012 km。"
      },
      "prereq": [],
      "next": [
        "motion-01"
      ],
      "tags": [
        "长度测量",
        "时间测量",
        "刻度尺",
        "秒表",
        "单位换算"
      ]
    },
    {
      "id": "motion-01",
      "title": "速度",
      "level": "基础",
      "definition": "速度表示物体运动的快慢，数值等于在计时区间内通过的路程与所用时间之比。相同时间内路程越长，速度越大；同一路程用时越短，速度越大。",
      "meaning": "比较快慢时可控制路程或时间中的一个量不变，也可统一用路程除以时间计算。速度是比值，平均速度描述一段过程而非每一瞬间；单位换算时 1 m/s=3.6 km/h。计算前确认距离和时间用相容单位。",
      "symbols": {
        "s": {
          "desc": "物体在计时区间内通过的路程",
          "unit": "m"
        },
        "t": {
          "desc": "通过路程 s 所用时间",
          "unit": "s"
        },
        "v": {
          "desc": "以米每秒表示的速度",
          "unit": "m/s"
        },
        "v_k": {
          "desc": "同一速度以千米每小时表示",
          "unit": "km/h"
        }
      },
      "scenarios": {
        "步行测量": {
          "s": 100,
          "t": 20,
          "v": 5,
          "v_k": 18
        },
        "操场跑步": {
          "s": 500,
          "t": 100,
          "v": 5,
          "v_k": 18
        }
      },
      "formulas": [
        {
          "name": "由路程和时间求速度",
          "expr": "v = s/t",
          "when": "路程和时间来自同一运动区间，s 用 m、t 用 s。",
          "checks": [
            {
              "type": "numeric",
              "scenario": "步行测量",
              "expr": "s/t",
              "ref": 5,
              "note": "100 m ÷ 20 s = 5 m/s。"
            },
            {
              "type": "numeric",
              "scenario": "操场跑步",
              "expr": "s/t",
              "ref": 5,
              "note": "500 m ÷ 100 s = 5 m/s，另一组测量复算。"
            },
            {
              "type": "direction",
              "scenario": "步行测量",
              "var": "s",
              "lo": 50,
              "hi": 200,
              "expr": "s/t",
              "expect": "up",
              "note": "计时相同时，路程越长，平均速度越大。"
            },
            {
              "type": "scan",
              "scenario": "步行测量",
              "var": "t",
              "lo": 1,
              "hi": 200,
              "note": "扫描正计时范围，检查速度计算稳定。"
            },
            {
              "type": "consistency",
              "scenario": "步行测量",
              "expr": "s/t",
              "with": "motion-01|米每秒换算为千米每小时",
              "with_expr": "v_k/3.6",
              "target": "同一速度的两种单位表示",
              "note": "直接以路程时间求 m/s，再用 km/h 换算回 m/s，结果应相同。"
            }
          ]
        },
        {
          "name": "米每秒换算为千米每小时",
          "expr": "v_k = 3.6*v",
          "when": "原速度用 m/s 表示，换算后的速度用 km/h 表示。",
          "checks": [
            {
              "type": "numeric",
              "scenario": "步行测量",
              "expr": "3.6*v",
              "ref": 18,
              "note": "5 m/s × 3.6 = 18 km/h。"
            },
            {
              "type": "numeric",
              "scenario": "操场跑步",
              "expr": "3.6*v",
              "ref": 18,
              "note": "同一速度的换算值保持一致。"
            },
            {
              "type": "direction",
              "scenario": "步行测量",
              "var": "v",
              "lo": 1,
              "hi": 20,
              "expr": "3.6*v",
              "expect": "up",
              "note": "正比例换算，原速度增大时 km/h 数值增大。"
            },
            {
              "type": "scan",
              "scenario": "步行测量",
              "var": "v",
              "lo": 0,
              "hi": 50,
              "note": "扫描非负速度范围，换算结果保持有限。"
            }
          ]
        }
      ],
      "derivation": [
        "用刻度尺测出运动路程 s，用秒表测出相应时间 t。",
        "依据速度定义计算 v=s/t；m 除以 s 得到 m/s。",
        "如需换成 km/h，把 m/s 数值乘 3.6，并在比较前统一速度单位。"
      ],
      "errors": [
        {
          "wrong": "把速度写成路程乘时间。",
          "wrong_expr": "v = s*t",
          "why": "速度是单位时间内通过的路程，需用路程除以时间；相乘的单位也不再是 m/s。",
          "caught_by": "量纲一致性",
          "trap_test": {
            "scenario": "步行测量",
            "expr": "s*t",
            "ref": 5
          }
        },
        {
          "wrong": "换算 m/s 与 km/h 时忘记乘 3.6，或把乘除方向写反。",
          "why": "1 m/s=3.6 km/h；5 m/s 应为 18 km/h，而不是约 1.4 km/h。",
          "caught_by": "数值代入",
          "trap_test": {
            "scenario": "步行测量",
            "expr": "v/3.6",
            "ref": 18
          },
          "wrong_expr": "v_k = v/3.6"
        }
      ],
      "example": {
        "stem": "小明 20 s 走过 100 m，求平均速度并换算成 km/h。",
        "solution": [
          "v=s/t=100/20=5 m/s。",
          "换算为 km/h：5×3.6=18 km/h。"
        ],
        "answer": "平均速度为 5 m/s，即 18 km/h。"
      },
      "prereq": [],
      "next": [
        "motion-02"
      ],
      "tags": [
        "速度",
        "路程",
        "时间",
        "单位换算"
      ]
    },
    {
      "id": "motion-02",
      "title": "直线运动",
      "level": "基础",
      "definition": "物体沿直线运动时，位置随时间变化。若相等时间内通过相等路程，运动是匀速直线运动；运动快慢改变时属于变速直线运动，常用全程平均速度描述整体快慢。",
      "meaning": "分段运动的全程平均速度要用总路程除以总时间，不能把各段速度简单平均，除非时间或路程条件恰好支持。利用运动图像还要先读横纵轴和单位；折线斜率或面积的含义须根据图轴定义判断。",
      "symbols": {
        "s1": {
          "desc": "第一段路程",
          "unit": "m"
        },
        "s2": {
          "desc": "第二段路程",
          "unit": "m"
        },
        "t1": {
          "desc": "第一段用时",
          "unit": "s"
        },
        "t2": {
          "desc": "第二段用时",
          "unit": "s"
        },
        "s_total": {
          "desc": "全程总路程",
          "unit": "m"
        },
        "t_total": {
          "desc": "全程总时间",
          "unit": "s"
        },
        "v_avg": {
          "desc": "全程平均速度",
          "unit": "m/s"
        },
        "v1": {
          "desc": "第一段平均速度",
          "unit": "m/s"
        },
        "v2": {
          "desc": "第二段平均速度",
          "unit": "m/s"
        }
      },
      "scenarios": {
        "两段各100米": {
          "s1": 100,
          "s2": 100,
          "t1": 10,
          "t2": 50,
          "s_total": 200,
          "t_total": 60,
          "v_avg": 3.3333333333333335,
          "v1": 10,
          "v2": 2
        },
        "两段等时": {
          "s1": 60,
          "s2": 20,
          "t1": 10,
          "t2": 10,
          "s_total": 80,
          "t_total": 20,
          "v_avg": 4,
          "v1": 6,
          "v2": 2
        }
      },
      "formulas": [
        {
          "name": "分段路程和时间求全程平均速度",
          "expr": "v_avg = (s1+s2)/(t1+t2)",
          "when": "总路程为各段路程之和，总时间为各段用时之和。",
          "checks": [
            {
              "type": "numeric",
              "scenario": "两段各100米",
              "expr": "(s1+s2)/(t1+t2)",
              "ref": 3.3333333333333335,
              "note": "200 m ÷ 60 s ≈ 3.33 m/s。"
            },
            {
              "type": "numeric",
              "scenario": "两段等时",
              "expr": "(s1+s2)/(t1+t2)",
              "ref": 4,
              "note": "80 m ÷ 20 s = 4 m/s。"
            },
            {
              "type": "direction",
              "scenario": "两段等时",
              "var": "s1",
              "lo": 10,
              "hi": 100,
              "expr": "(s1+s2)/(t1+t2)",
              "expect": "up",
              "note": "其余量固定时，增加一段路程会增加全程平均速度。"
            },
            {
              "type": "scan",
              "scenario": "两段等时",
              "var": "t1",
              "lo": 1,
              "hi": 100,
              "note": "扫描正分段用时，平均速度计算保持有限。"
            },
            {
              "type": "consistency",
              "scenario": "两段等时",
              "expr": "(s1+s2)/(t1+t2)",
              "with": "motion-02|分段路程与时间的累计",
              "with_expr": "s_total/t_total",
              "target": "同一全程的平均速度",
              "note": "分段相加后计算，与直接用总路程除以总时间交叉核对。"
            }
          ]
        },
        {
          "name": "分段路程与时间的累计",
          "expr": "s_total = s1+s2",
          "when": "各段路程不重叠且覆盖整个计时区间。",
          "checks": [
            {
              "type": "numeric",
              "scenario": "两段各100米",
              "expr": "s1+s2",
              "ref": 200,
              "note": "100 m+100 m=200 m。"
            },
            {
              "type": "numeric",
              "scenario": "两段等时",
              "expr": "s1+s2",
              "ref": 80,
              "note": "60 m+20 m=80 m。"
            },
            {
              "type": "scan",
              "scenario": "两段等时",
              "var": "s1",
              "lo": 1,
              "hi": 500,
              "note": "扫描正路程范围，分段累计无异常。"
            }
          ]
        }
      ],
      "derivation": [
        "按每段路程与用时分别计算分段速度。",
        "把没有重复计算的各段路程相加，并把各段用时相加。",
        "用总路程除以总时间，得到全程平均速度。"
      ],
      "errors": [
        {
          "wrong": "不看分段时间和路程条件，直接把两段速度做算术平均。",
          "wrong_expr": "v_avg = (v1+v2)/2",
          "why": "两段各 100 m 时，10 m/s 与 2 m/s 的算术平均为 6 m/s，但全程平均速度是 200/60≈3.33 m/s。",
          "caught_by": "数值代入",
          "trap_test": {
            "scenario": "两段各100米",
            "expr": "(v1+v2)/2",
            "ref": 3.3333333333333335
          }
        },
        {
          "wrong": "计算全程平均速度时漏掉中途一段或漏计题目要求包含的时间。",
          "why": "平均速度必须与题目界定的整段总路程和总时间对应，计时范围要先确认。",
          "caught_by": "人工审核"
        }
      ],
      "example": {
        "stem": "物体先以 10 m/s 运动 10 s，再以 2 m/s 运动 50 s，求全程平均速度。",
        "solution": [
          "第一段路程 100 m，第二段路程 100 m。",
          "总路程 200 m，总时间 60 s。",
          "平均速度为 200/60≈3.33 m/s。"
        ],
        "answer": "全程平均速度约为 3.33 m/s。"
      },
      "prereq": [
        "motion-01"
      ],
      "next": [
        "motion-04"
      ],
      "tags": [
        "直线运动",
        "匀速直线运动",
        "变速直线运动",
        "平均速度",
        "分段运动"
      ]
    },
    {
      "id": "motion-04",
      "title": "运动的相对性",
      "level": "基础",
      "definition": "判断物体运动还是静止，必须选定参照物。同一物体相对不同参照物可能有不同运动状态；同一直线上两物体的相对速度可由它们速度之差或和求得，取决于运动方向。",
      "meaning": "坐在行驶列车中的乘客相对车厢静止，但相对地面运动，这说明运动描述具有相对性。计算相对速度前先画出方向：同向追及取速度差，反向相向运动取速度和；速度大小关系决定相对位置变化方向，不能只看公式符号。",
      "symbols": {
        "v_A": {
          "desc": "物体 A 沿选定方向的速度大小",
          "unit": "m/s"
        },
        "v_B": {
          "desc": "物体 B 沿选定方向的速度大小",
          "unit": "m/s"
        },
        "v_rel": {
          "desc": "两物体之间的相对速度大小",
          "unit": "m/s"
        },
        "s_gap": {
          "desc": "两物体间距在计时段内改变的大小",
          "unit": "m"
        },
        "t": {
          "desc": "观察的时间间隔",
          "unit": "s"
        }
      },
      "scenarios": {
        "同向追及1秒": {
          "v_A": 12,
          "v_B": 4,
          "v_rel": 8,
          "s_gap": 8,
          "t": 1
        },
        "同向追及2秒": {
          "v_A": 15,
          "v_B": 5,
          "v_rel": 10,
          "s_gap": 20,
          "t": 2
        },
        "相向而行": {
          "v_A": 12,
          "v_B": 4,
          "v_rel": 16,
          "s_gap": 16,
          "t": 1
        },
        "相向而行二": {
          "v_A": 10,
          "v_B": 6,
          "v_rel": 16,
          "s_gap": 32,
          "t": 2
        }
      },
      "formulas": [
        {
          "name": "同向运动的相对速度",
          "expr": "v_rel = v_A-v_B",
          "when": "两物体沿同一直线同向运动，且 A 的速度大于 B 的速度；取间距改变速度的大小。",
          "checks": [
            {
              "type": "numeric",
              "scenario": "同向追及1秒",
              "expr": "v_A-v_B",
              "ref": 8,
              "note": "12 m/s 与 4 m/s 同向时，速度差为 8 m/s。 "
            },
