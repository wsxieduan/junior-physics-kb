{
  "chapter": "物质的物理属性",
  "order": 6,
  "intro": "按目录整理质量测量、密度，以及密度应用与其他物理属性的关系；未给没有可靠定量规律的属性硬编公式。",
  "points": [
    {
      "id": "prop-03",
      "title": "质量及其测量",
      "level": "基础",
      "definition": "质量表示物体所含物质的多少，国际单位是千克，实验中常用天平测量。物体从一个地点移到另一个地点，质量不因位置变化而改变；记录时应写清单位。",
      "meaning": "使用天平前先放平、调平衡，再把物体和砝码按规范放置，砝码质量与游码示数相加得到物体质量。称量结果常需在 g 与 kg 之间换算；克数与千克数表示同一质量，不代表物体发生变化。测量值应根据仪器分度值合理记录。",
      "symbols": {
        "m_g": {
          "desc": "以克记录的质量",
          "unit": "g"
        },
        "m_kg": {
          "desc": "同一质量以千克记录",
          "unit": "kg"
        }
      },
      "scenarios": {
        "小物体称量": {
          "m_g": 450,
          "m_kg": 0.45
        },
        "书包称量": {
          "m_g": 2500,
          "m_kg": 2.5
        }
      },
      "formulas": [
        {
          "name": "克换算为千克",
          "expr": "m_kg = m_g/1000",
          "when": "同一质量单位换算，1000 g=1 kg。",
          "checks": [
            {
              "type": "numeric",
              "scenario": "小物体称量",
              "expr": "m_g/1000",
              "ref": 0.45,
              "note": "450 g=0.45 kg。 "
            },
            {
              "type": "numeric",
              "scenario": "书包称量",
              "expr": "m_g/1000",
              "ref": 2.5,
              "note": "2500 g=2.5 kg。 "
            },
            {
              "type": "direction",
              "scenario": "小物体称量",
              "var": "m_g",
              "lo": 1,
              "hi": 5000,
              "expr": "m_g/1000",
              "expect": "up",
              "note": "克数增大时，千克数按比例增大。 "
            },
            {
              "type": "scan",
              "scenario": "小物体称量",
              "var": "m_g",
              "lo": 0.1,
              "hi": 10000,
              "note": "扫描正质量，单位换算保持有限。 "
            },
            {
              "type": "consistency",
              "scenario": "小物体称量",
              "expr": "m_g/1000",
              "with": "prop-03|千克换算为克",
              "with_expr": "m_kg",
              "target": "同一物体的千克质量",
              "note": "克换千克的结果应与千克记录值一致。 "
            }
          ]
        },
        {
          "name": "千克换算为克",
          "expr": "m_g = 1000*m_kg",
          "when": "同一质量单位换算，1 kg=1000 g。",
          "checks": [
            {
              "type": "numeric",
              "scenario": "小物体称量",
              "expr": "1000*m_kg",
              "ref": 450,
              "note": "0.45 kg=450 g。 "
            },
            {
              "type": "numeric",
              "scenario": "书包称量",
              "expr": "1000*m_kg",
              "ref": 2500,
              "note": "2.5 kg=2500 g。 "
            },
            {
              "type": "direction",
              "scenario": "书包称量",
              "var": "m_kg",
              "lo": 0.01,
              "hi": 50,
              "expr": "1000*m_kg",
              "expect": "up",
              "note": "千克数增大时，克数相应增大。 "
            },
            {
              "type": "scan",
              "scenario": "书包称量",
              "var": "m_kg",
              "lo": 0.001,
              "hi": 100,
              "note": "扫描正质量，换算数值保持稳定。 "
            }
          ]
        }
      ],
      "derivation": [
        "用天平测得物体质量，并记录天平示数和所用质量单位。",
        "按 1 kg=1000 g 换算：克换成千克除以 1000，千克换成克乘以 1000。",
        "换算后再反向换回，核对读数是否与原始称量一致。"
      ],
      "errors": [
        {
          "wrong": "克换千克时少除一个 10，产生十倍偏差。",
          "wrong_expr": "m_kg = m_g/100",
          "why": "450 g 应为 0.45 kg；若只除以 100，会得到 4.5 kg。",
          "caught_by": "数值代入",
          "trap_test": {
            "scenario": "小物体称量",
            "expr": "m_g/100",
            "ref": 0.45
          }
        },
        {
          "wrong": "认为物体移到月球后质量随重力变小。",
          "why": "质量表示物体所含物质多少，不随位置变化；变化的是物体受到的重力。",
          "caught_by": "人工审核"
        }
      ],
      "example": {
        "stem": "天平测得一块金属质量为 780 g，换算成千克。",
        "solution": [
          "1000 g=1 kg。",
          "780÷1000=0.780 kg。"
        ],
        "answer": "质量为 0.780 kg。"
      },
      "prereq": [],
      "next": [
        "prop-01"
      ],
      "tags": [
        "质量",
        "天平",
        "千克",
        "克",
        "质量测量"
      ]
    },
    {
      "id": "prop-01",
      "title": "密度",
      "level": "基础",
      "definition": "密度是物质单位体积的质量，等于物体质量与体积之比。对同一种均匀物质，密度通常可用于识别材料；物体质量和体积同时变化时，不能只凭其中一个量判断密度。",
      "meaning": "测密度要分别可靠地测质量和体积，再用质量除以体积；不规则物体可用排水法测体积。读质量—体积图线时，密度对应斜率而不是任意一点的纵坐标。先统一质量和体积单位，常见换算为 1 g/cm³=1000 kg/m³。",
      "symbols": {
        "m": {
          "desc": "物体质量",
          "unit": "kg"
        },
        "V": {
          "desc": "物体体积",
          "unit": "m^3"
        },
        "rho": {
          "desc": "物质密度",
          "unit": "kg/m^3"
        },
        "m_1": {
          "desc": "质量—体积图线上第一个读数点的质量",
          "unit": "kg"
        },
        "m_2": {
          "desc": "质量—体积图线上第二个读数点的质量",
          "unit": "kg"
        },
        "V_1": {
          "desc": "质量—体积图线上第一个读数点的体积",
          "unit": "m^3"
        },
        "V_2": {
          "desc": "质量—体积图线上第二个读数点的体积",
          "unit": "m^3"
        },
        "V1": {
          "desc": "放入物体前液体体积",
          "unit": "mL"
        },
        "V2": {
          "desc": "物体完全浸入后液体总体积",
          "unit": "mL"
        },
        "V_o": {
          "desc": "被测物体体积",
          "unit": "mL"
        }
      },
      "scenarios": {
        "一升水": {
          "m": 1,
          "V": 0.001,
          "rho": 1000
        },
        "两升水": {
          "m": 2,
          "V": 0.002,
          "rho": 1000
        },
        "水的质量体积图线一": {
          "m": 1,
          "V": 0.001,
          "rho": 1000,
          "m_1": 0.5,
          "V_1": 0.0005,
          "m_2": 1,
          "V_2": 0.001
        },
        "水的质量体积图线二": {
          "m": 1.5,
          "V": 0.0015,
          "rho": 1000,
          "m_1": 1,
          "V_1": 0.001,
          "m_2": 1.5,
          "V_2": 0.0015
        },
        "铝块测量一": {
          "V1": 50,
          "V2": 70,
          "V_o": 20,
          "m": 54,
          "rho": 2.7
        },
        "铝块测量二": {
          "V1": 40,
          "V2": 60,
          "V_o": 20,
          "m": 54,
          "rho": 2.7
        }
      },
      "formulas": [
        {
          "name": "由质量和体积求密度",
          "expr": "rho = m/V",
          "when": "质量和体积对应同一物体，且 m 用 kg、V 用 m^3。",
          "checks": [
            {
              "type": "numeric",
              "scenario": "一升水",
              "expr": "m/V",
              "ref": 1000,
              "note": "1 kg ÷ 0.001 m^3 = 1000 kg/m^3。"
            },
            {
              "type": "numeric",
              "scenario": "两升水",
              "expr": "m/V",
              "ref": 1000,
              "note": "质量和体积同时加倍，密度仍为 1000 kg/m^3。"
            },
            {
              "type": "direction",
              "scenario": "一升水",
              "var": "m",
              "lo": 0.5,
              "hi": 2,
              "expr": "m/V",
              "expect": "up",
              "note": "体积不变时，质量增加会使密度计算值增加。"
            },
            {
              "type": "scan",
              "scenario": "一升水",
              "var": "V",
              "lo": 0.0005,
              "hi": 0.005,
              "note": "扫描正体积范围，检查密度计算稳定。"
            },
            {
              "type": "consistency",
              "scenario": "一升水",
              "expr": "m/V",
              "with": "prop-01|由密度和体积求质量",
              "with_expr": "m/V",
              "target": "同一均匀物体的密度",
              "note": "先以质量除体积求密度，再用该密度关系复算质量与体积的比例。"
            }
          ]
        },
        {
          "name": "由密度和体积求质量",
          "expr": "m = rho*V",
          "when": "物体密度均匀，rho 用 kg/m^3、V 用 m^3。",
          "checks": [
            {
              "type": "numeric",
              "scenario": "一升水",
              "expr": "rho*V",
              "ref": 1,
              "note": "1000 kg/m^3 × 0.001 m^3 = 1 kg。"
            },
            {
              "type": "numeric",
              "scenario": "两升水",
              "expr": "rho*V",
              "ref": 2,
              "note": "1000 kg/m^3 × 0.002 m^3 = 2 kg。"
            },
            {
              "type": "scan",
              "scenario": "一升水",
              "var": "V",
              "lo": 0.0005,
              "hi": 0.005,
              "note": "扫描正体积范围，质量按比例变化。"
            }
          ]
        },
        {
          "name": "读取质量—体积图线斜率求密度",
          "expr": "rho = (m_2-m_1)/(V_2-V_1)",
          "when": "同一种均匀物质的质量—体积图线为正比例关系，读数点体积不同且质量、体积单位统一。",
          "checks": [
            {
              "type": "numeric",
              "scenario": "水的质量体积图线一",
              "expr": "(m_2-m_1)/(V_2-V_1)",
              "ref": 1000,
              "note": "图线上两点的质量差为 0.5 kg、体积差为 0.0005 m³，斜率为 1000 kg/m³。"
            },
            {
              "type": "numeric",
              "scenario": "水的质量体积图线二",
              "expr": "(m_2-m_1)/(V_2-V_1)",
              "ref": 1000,
              "note": "换用图线上另一段，两点差值之比仍为 1000 kg/m³。"
            },
            {
              "type": "consistency",
              "scenario": "水的质量体积图线一",
              "expr": "(m_2-m_1)/(V_2-V_1)",
              "with": "prop-01|由质量和体积求密度",
              "with_expr": "m/V",
              "target": "同一种水的密度",
              "note": "图线两点斜率与单个读数点的质量除以体积结果一致。"
            }
          ]
        }
      ],
      "derivation": [
        "密度定义为质量与体积的比值，先确认两者属于同一物体。",
        "用 m/V 计算密度并检查单位，kg 除以 m^3 得到 kg/m^3。",
        "在质量—体积图线上选取两个不同体积的点，用质量差除以体积差求斜率；均匀物质的该斜率就是密度。",
        "将定义式变形，可由密度和体积求质量。"
      ],
      "errors": [
        {
          "wrong": "把密度写成体积除以质量。",
          "wrong_expr": "rho = V/m",
          "why": "密度定义是单位体积的质量；质量越多而体积不变时，密度应增大。",
          "caught_by": "量纲一致性",
          "trap_test": {
            "scenario": "一升水",
            "expr": "V/m",
            "ref": 1000
          }
        },
        {
          "wrong": "质量已经用 kg 表示时，又多除以 1000，造成密度少算 1000 倍。",
          "wrong_expr": "rho = (m/1000)/V",
          "why": "情境中的质量已是 kg，无须再次换算成吨；一升水应为 1000 kg/m^3，不是 1 kg/m^3。",
          "caught_by": "数值代入",
          "trap_test": {
            "scenario": "一升水",
            "expr": "(m/1000)/V",
            "ref": 1000
          }
        },
        {
          "wrong": "认为同一种物质的物体质量越大，密度一定越大。",
          "why": "在温度和状态相同、物质均匀时，质量和体积同比变化，密度不随样品多少改变。",
          "caught_by": "人工审核"
        }
      ],
      "example": {
        "stem": "一块均匀材料质量为 2 kg，体积为 0.001 m^3，求密度。",
        "solution": [
          "rho=m/V=2/0.001=2000 kg/m^3。",
          "单位为 kg/m^3，表示每立方米该材料的质量。"
        ],
        "answer": "密度为 2000 kg/m^3。"
      },
      "prereq": [],
      "next": [
        "prop-02"
      ],
      "tags": [
        "密度",
        "质量",
        "体积",
        "质量体积图像"
      ]
    },
    {
      "id": "prop-02",
      "title": "密度知识的应用与物质的物理属性",
      "level": "基础",
      "definition": "密度知识可用于鉴别材料、判断空心与实心、估测质量或体积；物质还具有硬度、弹性、导电性、导热性和磁性等属性。测量不规则固体时可用排水法求体积，再结合质量求密度。",
      "meaning": "同一种材料通常具有相对稳定的密度，但温度、状态和测量误差会影响实际数值；判断材料时应结合多个证据。密度只是物质多种物理属性之一，不能用密度代替硬度、导电性或磁性。排水法读数时要排除气泡并保证物体完全浸没且不溶于水。",
      "symbols": {
        "V1": {
          "desc": "放入物体前液体体积",
          "unit": "mL"
        },
        "V2": {
          "desc": "物体完全浸入后液体总体积",
          "unit": "mL"
        },
        "V_o": {
          "desc": "被测物体体积",
          "unit": "mL"
        },
        "m": {
          "desc": "被测物体质量",
          "unit": "g"
        },
        "rho": {
          "desc": "被测物体密度",
          "unit": "g/mL"
        },
        "V": {
          "desc": "物体体积",
          "unit": "m^3"
        },
        "m_1": {
          "desc": "质量—体积图线上第一个读数点的质量",
          "unit": "kg"
        },
        "m_2": {
          "desc": "质量—体积图线上第二个读数点的质量",
          "unit": "kg"
        },
        "V_1": {
          "desc": "质量—体积图线上第一个读数点的体积",
          "unit": "m^3"
        },
        "V_2": {
          "desc": "质量—体积图线上第二个读数点的体积",
          "unit": "m^3"
        }
      },
      "scenarios": {
        "铝块测量一": {
          "V1": 50,
          "V2": 70,
          "V_o": 20,
          "m": 54,
          "rho": 2.7
        },
        "铝块测量二": {
          "V1": 40,
          "V2": 60,
          "V_o": 20,
          "m": 54,
          "rho": 2.7
        },
        "一升水": {
          "m": 1,
          "V": 0.001,
          "rho": 1000
        },
        "两升水": {
          "m": 2,
          "V": 0.002,
          "rho": 1000
        },
        "水的质量体积图线一": {
          "m": 1,
          "V": 0.001,
          "rho": 1000,
          "m_1": 0.5,
          "V_1": 0.0005,
          "m_2": 1,
          "V_2": 0.001
        },
        "水的质量体积图线二": {
          "m": 1.5,
          "V": 0.0015,
          "rho": 1000,
          "m_1": 1,
          "V_1": 0.001,
          "m_2": 1.5,
          "V_2": 0.0015
        }
      },
      "formulas": [
        {
          "name": "排水法求物体体积",
          "expr": "V_o = V2-V1",
          "when": "物体完全浸没、不吸水且液体体积读数单位相同。",
          "checks": [
            {
              "type": "numeric",
              "scenario": "铝块测量一",
              "expr": "V2-V1",
              "ref": 20,
              "note": "70 mL-50 mL=20 mL。"
            },
            {
              "type": "numeric",
              "scenario": "铝块测量二",
              "expr": "V2-V1",
              "ref": 20,
              "note": "60 mL-40 mL=20 mL，重复测量相符。"
            },
            {
              "type": "direction",
              "scenario": "铝块测量一",
              "var": "V2",
              "lo": 55,
              "hi": 90,
              "expr": "V2-V1",
              "expect": "up",
              "note": "初始液量不变时，液面上升越多，物体体积越大。"
            },
            {
