              "scenario": "铝块测量一",
              "expr": "V2-V1",
              "with": "prop-02|由排水体积求材料密度",
              "with_expr": "m/rho",
              "target": "同一铝块体积",
              "note": "一条路径比较量筒液面差，另一条由已测质量和密度反算体积。"
            }
          ]
        },
        {
          "name": "由排水体积求材料密度",
          "expr": "rho = m/V_o",
          "when": "物体质量以 g、测得体积以 mL 计，密度单位为 g/mL。",
          "checks": [
            {
              "type": "numeric",
              "scenario": "铝块测量一",
              "expr": "m/(V2-V1)",
              "ref": 2.7,
              "note": "54 g÷20 mL=2.7 g/mL，接近铝的常见密度。"
            },
            {
              "type": "numeric",
              "scenario": "铝块测量二",
              "expr": "m/(V2-V1)",
              "ref": 2.7,
              "note": "重复测量计算得到相同密度。"
            },
            {
              "type": "direction",
              "scenario": "铝块测量一",
              "var": "m",
              "lo": 20,
              "hi": 100,
              "expr": "m/(V2-V1)",
              "expect": "up",
              "note": "体积固定时，测得质量增加，密度计算值增加。"
            },
            {
              "type": "scan",
              "scenario": "铝块测量一",
              "var": "V2",
              "lo": 51,
              "hi": 100,
              "note": "扫描正体积差，密度计算不发生除零。"
            }
          ]
        }
      ],
      "derivation": [
        "读取物体浸入前量筒体积 V1。",
        "将物体完全浸没，读取液体总体积 V2。",
        "用 V2-V1 得到排开液体体积，并在适用条件下视为物体体积。",
        "若还测得物体质量，用 m/V_o 求密度。"
      ],
      "errors": [
        {
          "wrong": "把物体体积写成放入前后液体读数之和。",
          "wrong_expr": "V_o = V2+V1",
          "why": "物体排开的是液面增加的部分，应以后读数减前读数；50 mL 升至 70 mL，物体体积为 20 mL。",
          "caught_by": "数值代入",
