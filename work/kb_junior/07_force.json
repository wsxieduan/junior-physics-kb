{
  "chapter": "力",
  "order": 7,
  "intro": "按苏科版2024目录整理力与弹力、重力与力的示意图、摩擦力和力的相互作用；弹簧线性关系单列为拓展，摩擦力计算严格限定实验条件。",
  "points": [
    {
      "id": "force-03",
      "title": "力 弹力",
      "level": "拓展",
      "definition": "物体发生弹性形变时会产生弹力，弹力方向与形变方向相反。对形变范围内近似线性的弹簧，弹力大小可用弹簧劲度系数与形变量的乘积估算；超出弹性范围时不能套用线性关系。",
      "meaning": "弹力可以通过弹簧测力计感受和测量，弹簧伸长量越大，弹力通常越大。这里的 F=kx 是线性弹簧的拓展模型，教材基础要求主要是辨认弹力、方向和产生条件；实际弹簧若发生明显弯折、塑性形变或接近极限，比例关系不再适用。",
      "symbols": {
        "F_e": {
          "desc": "弹簧弹力大小",
          "unit": "N"
        },
        "k": {
          "desc": "线性弹簧劲度系数",
          "unit": "N/m"
        },
        "x": {
          "desc": "弹簧相对原长的形变量",
          "unit": "m"
        }
      },
      "scenarios": {
        "小形变弹簧": {
          "F_e": 2,
          "k": 100,
          "x": 0.02
        },
        "另一弹簧": {
          "F_e": 3,
          "k": 150,
          "x": 0.02
        }
      },
      "formulas": [
        {
          "name": "线性弹簧弹力与形变量关系",
          "expr": "F_e = k*x",
          "when": "仅用于弹性限度内近似线性的弹簧；x 是相对原长的形变量。",
          "checks": [
            {
              "type": "numeric",
              "scenario": "小形变弹簧",
              "expr": "k*x",
              "ref": 2,
              "note": "劲度系数 100 N/m、形变量 0.02 m，对应弹力 2 N。 "
            },
            {
              "type": "numeric",
              "scenario": "另一弹簧",
              "expr": "k*x",
              "ref": 3,
              "note": "劲度系数 150 N/m、形变量 0.02 m，对应弹力 3 N。 "
            },
            {
              "type": "direction",
              "scenario": "小形变弹簧",
              "var": "x",
              "lo": 0.001,
              "hi": 0.05,
              "expr": "k*x",
              "expect": "up",
              "note": "在线性范围内，形变量增大时弹力增大。 "
            },
            {
              "type": "scan",
              "scenario": "小形变弹簧",
              "var": "x",
              "lo": 0,
              "hi": 0.1,
              "note": "扫描非负小形变，估算弹力保持有限。 "
            },
            {
              "type": "consistency",
              "scenario": "小形变弹簧",
              "expr": "k*x",
              "with": "force-03|由弹力和劲度系数求形变量",
              "with_expr": "F_e",
              "target": "线性弹簧弹力",
              "note": "由劲度系数和形变量估算弹力，并与由力测量值反推的弹力相互核对。 "
            }
          ]
        },
        {
          "name": "由弹力和劲度系数求形变量",
          "expr": "x = F_e/k",
          "when": "弹簧仍在线性弹性范围内，k 大于零。",
          "checks": [
            {
              "type": "numeric",
              "scenario": "小形变弹簧",
              "expr": "F_e/k",
              "ref": 0.02,
              "note": "2 N ÷ 100 N/m=0.02 m。 "
            },
            {
              "type": "numeric",
              "scenario": "另一弹簧",
              "expr": "F_e/k",
              "ref": 0.02,
              "note": "3 N ÷ 150 N/m=0.02 m。 "
            },
            {
              "type": "direction",
              "scenario": "小形变弹簧",
              "var": "F_e",
              "lo": 0.1,
              "hi": 10,
              "expr": "F_e/k",
              "expect": "up",
              "note": "劲度系数固定时弹力增大，形变量增大。 "
            },
            {
              "type": "scan",
              "scenario": "小形变弹簧",
              "var": "F_e",
              "lo": 0,
              "hi": 20,
              "note": "扫描非负弹力范围，反推形变量有限。 "
            }
          ]
        }
      ],
      "derivation": [
        "确定弹簧原长和受力后的长度，两者之差为形变量 x。",
        "在线性弹性范围内，实验表明弹力大小与形变量成正比，比例系数为 k。",
        "使用 F_e=kx 前检查弹簧没有超过弹性限度，并统一 N、N/m 和 m。"
      ],
      "errors": [
        {
          "wrong": "线性弹簧计算中漏掉劲度系数与形变量乘积的一半因子。",
          "wrong_expr": "F_e = k*x/2",
          "why": "在已确认线性范围内，弹力按 kx 计算；小形变情境中漏乘比例系数会得到一半结果。",
          "caught_by": "数值代入",
          "trap_test": {
            "scenario": "小形变弹簧",
            "expr": "k*x/2",
            "ref": 2
          }
        },
        {
          "wrong": "认为任何材料、任何形变都遵守线性弹簧关系。",
          "why": "线性关系只适用于弹性限度内近似线性的弹簧；塑性形变或超过弹性限度时不可套用。",
          "caught_by": "人工审核"
        }
      ],
      "example": {
        "stem": "劲度系数为 100 N/m 的弹簧在弹性限度内伸长 0.03 m，估算弹力。",
        "solution": [
          "确认形变量在弹性限度内。",
          "F_e=kx=100×0.03=3 N。"
        ],
        "answer": "弹力约为 3 N。"
      },
      "prereq": [
        "force-01"
      ],
      "next": [
        "force-04"
      ],
      "tags": [
        "弹力",
        "弹性形变",
        "弹簧",
        "劲度系数",
        "拓展"
      ]
    },
    {
      "id": "force-01",
      "title": "重力 力的示意图",
      "level": "基础",
      "definition": "地球附近的物体受到重力，重力方向竖直向下，大小与物体质量近似成正比。力的示意图用带箭头的线段表示力的大小、方向和作用点；作图前先选定研究对象。",
      "meaning": "在地球表面附近常用 G=mg 估算重力，比例系数 g 约为 9.8 N/kg，粗略计算可取 10 N/kg。质量和重力不是同一个量：质量用 kg，重力用 N。画示意图时箭头方向表示力方向，线段长短可按比例表示大小，不要把重力方向画成总是垂直于斜面。",
      "symbols": {
        "G": {
          "desc": "物体所受重力",
          "unit": "N"
        },
        "m": {
          "desc": "物体质量",
          "unit": "kg"
        },
        "mg": {
          "desc": "以克记录的质量数值，代入前要换成 kg",
          "unit": "g"
        },
        "g": {
          "desc": "当地重力与质量的比值，估算取 10 N/kg",
          "unit": "N/kg"
        },
        "F_AB": {
          "desc": "物体 A 对物体 B 的作用力大小",
          "unit": "N"
        },
        "F_BA": {
          "desc": "物体 B 对物体 A 的作用力大小",
          "unit": "N"
        },
        "F_ABx": {
          "desc": "A 对 B 的作用力沿选定方向的分量，正负表示方向",
          "unit": "N"
        },
        "F_BAx": {
          "desc": "B 对 A 的作用力沿同一选定方向的分量，正负表示方向",
          "unit": "N"
        },
        "F_sum": {
          "desc": "这两个相互作用力沿选定方向的分量代数和",
          "unit": "N"
        }
      },
      "scenarios": {
        "小球": {
          "G": 2,
          "m": 0.2,
          "g": 10
        },
        "书包": {
          "G": 20,
          "m": 2,
          "g": 10
        },
        "克单位误代": {
          "G": 2,
          "m": 0.2,
          "mg": 200,
          "g": 10
        },
        "手推墙": {
          "F_AB": 5,
          "F_BA": 5,
          "F_ABx": 5,
          "F_BAx": -5,
          "F_sum": 0
        },
        "两磁体排斥": {
          "F_AB": 12,
          "F_BA": 12,
          "F_ABx": 12,
          "F_BAx": -12,
          "F_sum": 0
        }
      },
      "formulas": [
        {
          "name": "质量与重力的关系",
          "expr": "G = m*g",
          "when": "近地面估算时取 g≈10 N/kg；更精确计算可按题目给定 g。",
          "checks": [
            {
              "type": "numeric",
              "scenario": "小球",
              "expr": "m*g",
              "ref": 2,
              "note": "0.2 kg×10 N/kg=2 N。"
            },
            {
              "type": "numeric",
              "scenario": "书包",
              "expr": "m*g",
              "ref": 20,
              "note": "2 kg×10 N/kg=20 N。"
            },
            {
              "type": "direction",
              "scenario": "小球",
              "var": "m",
              "lo": 0.1,
              "hi": 5,
              "expr": "m*g",
              "expect": "up",
              "note": "同一地点 g 固定，质量增大则重力增大。"
            },
            {
              "type": "scan",
              "scenario": "小球",
              "var": "m",
              "lo": 0,
              "hi": 100,
              "note": "扫描非负质量范围，重力随质量线性变化。"
            },
            {
              "type": "consistency",
              "scenario": "小球",
              "expr": "m*g",
              "with": "force-01|由重力估算质量",
              "with_expr": "G",
              "target": "同一物体的重力大小",
              "note": "由质量和当地 g 预测重力，再与情境中给定的重力测量值核对。"
            }
          ]
        },
        {
          "name": "由重力估算质量",
          "expr": "m = G/g",
          "when": "重力 G 与当地重力加速度 g 已知，且 g 不为零。",
          "checks": [
            {
              "type": "numeric",
              "scenario": "小球",
              "expr": "G/g",
              "ref": 0.2,
              "note": "2 N÷10 N/kg=0.2 kg。"
            },
            {
              "type": "numeric",
              "scenario": "书包",
              "expr": "G/g",
              "ref": 2,
              "note": "20 N÷10 N/kg=2 kg。"
            },
            {
              "type": "scan",
              "scenario": "小球",
              "var": "G",
              "lo": 0,
              "hi": 100,
              "note": "扫描非负重力范围，反算质量保持有限。"
            }
          ]
        }
      ],
      "derivation": [
        "物体质量为 m，每千克物体受到的重力用 g 表示。",
        "重力随质量成正比，所以重力大小为 G=m*g。",
        "移项可由重力与当地 g 反算物体质量。"
      ],
      "errors": [
        {
          "wrong": "把重力写成质量除以 g。",
          "wrong_expr": "G = m/g",
          "why": "g 的单位是 N/kg，重力应为 m*g 才得到 N；除法会得到不符合力单位的结果。",
          "caught_by": "量纲一致性",
          "trap_test": {
            "scenario": "小球",
            "expr": "m/g",
            "ref": 2
          }
        },
        {
          "wrong": "质量以克记录时，把克的数值直接当作 kg 代入重力公式。",
          "wrong_expr": "G = mg*g",
          "why": "200 g 应先换成 0.2 kg；把数值 200 直接代入会把重力算大 1000 倍。",
          "caught_by": "数值代入",
          "trap_test": {
            "scenario": "克单位误代",
            "expr": "mg*g",
            "ref": 2
          }
        },
        {
          "wrong": "把质量和重力看成同一个量，直接用 kg 表示重力。",
          "why": "质量单位为 kg，重力单位为 N；二者通过当地 g 联系，但概念和单位不同。",
          "caught_by": "人工审核"
        }
      ],
      "example": {
        "stem": "一只质量 3 kg 的物体在地面附近运动，取 g=10 N/kg，求其重力。",
        "solution": [
          "G=mg=3×10=30 N。",
          "重力方向竖直向下。"
        ],
        "answer": "重力大小为 30 N，方向竖直向下。"
      },
      "prereq": [],
      "next": [
        "force-02"
      ],
      "tags": [
        "重力",
        "质量",
        "力的示意图",
        "竖直向下"
      ]
    },
    {
      "id": "force-04",
      "title": "摩擦力",
      "level": "基础",
      "definition": "两个相互接触的物体发生或将要发生相对运动时，接触面会产生阻碍相对运动的摩擦力。摩擦力方向沿接触面，且与相对运动或相对运动趋势方向相反。",
      "meaning": "摩擦力大小受压力和接触面情况等因素影响，不能仅凭物体是否运动判断。水平面上用弹簧测力计匀速拉动木块，若水平方向只受拉力和滑动摩擦力，则两力平衡，拉力读数等于摩擦力大小。改变条件时要区分静摩擦和滑动摩擦，不能把本实验结论推广到所有情况。",
