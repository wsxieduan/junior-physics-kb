              "type": "scan",
              "scenario": "二千克小车",
              "var": "a",
              "lo": 0,
              "hi": 20,
              "note": "扫描非负加速度，合力计算保持有限。 "
            },
            {
              "type": "consistency",
              "scenario": "二千克小车",
              "expr": "F_net/m",
              "with": "fmotion-03|速度变化率表示加速度",
              "with_expr": "dv/t",
              "target": "小车加速度",
              "note": "用合力除以质量得到的加速度，与速度变化量除以时间的测量值相互核对。 "
            }
          ]
        },
        {
          "name": "速度变化率表示加速度",
          "expr": "a = dv/t",
          "when": "加速度取速度变化量除以同一时间间隔，t 大于零。",
          "checks": [
            {
              "type": "numeric",
              "scenario": "二千克小车",
