{
  "chapter": "力与运动",
  "order": 8,
  "intro": "按苏科版2024目录整理二力平衡、牛顿第一定律与力和运动的关系；牛顿第二定律公式只作明确标记的拓展预览。",
  "points": [
    {
      "id": "fmotion-01",
      "title": "二力平衡",
      "level": "基础",
      "definition": "物体在两个力作用下保持静止或匀速直线运动时，这两个力互相平衡。二力平衡要求大小相等、方向相反、作用在同一条直线上，并作用于同一物体。",
      "meaning": "判断二力是否平衡，不能只看大小相等，还要检查方向、作用线和研究对象。沿同一直线取一个正方向后，反向两力的合力可用带方向的代数和表示；平衡时合力为零。作用力和反作用力虽然大小相等方向相反，但作用于不同物体，不能当作同一物体上的平衡力。",
      "symbols": {
        "F1": {
          "desc": "沿选定方向的第一个力的大小",
          "unit": "N"
        },
        "F2": {
          "desc": "与第一个力反向的第二个力的大小",
          "unit": "N"
        },
        "F_net": {
          "desc": "沿选定方向的合力",
          "unit": "N"
        }
      },
      "scenarios": {
        "桌面静止木块": {
          "F1": 5,
          "F2": 5,
          "F_net": 0
        },
        "匀速拉动木块": {
          "F1": 12,
          "F2": 12,
          "F_net": 0
        }
      },
      "formulas": [
        {
          "name": "反向共线两力的合力",
          "expr": "F_net = F1-F2",
          "when": "F1、F2 沿同一直线且方向相反；正方向取为 F1 方向。",
          "checks": [
            {
              "type": "numeric",
              "scenario": "桌面静止木块",
              "expr": "F1-F2",
              "ref": 0,
              "note": "5 N 与 5 N 反向，合力为 0 N。"
            },
            {
              "type": "numeric",
              "scenario": "匀速拉动木块",
              "expr": "F1-F2",
              "ref": 0,
              "note": "拉力与摩擦力等大反向，木块可保持匀速直线运动。"
            },
            {
              "type": "direction",
              "scenario": "桌面静止木块",
              "var": "F1",
              "lo": 0,
              "hi": 20,
              "expr": "F1-F2",
              "expect": "up",
              "note": "第二个力固定时，沿正方向的力增加，合力代数值增加。"
            },
            {
              "type": "scan",
              "scenario": "桌面静止木块",
              "var": "F1",
              "lo": 0,
              "hi": 100,
              "note": "扫描同一直线上的非负力大小，合力计算保持有限。"
            },
            {
              "type": "consistency",
              "scenario": "桌面静止木块",
              "expr": "F1-F2",
              "with": "fmotion-01|二力平衡条件",
              "with_expr": "F1-F2",
              "target": "二力平衡时的合力",
              "note": "从有向合力计算和等大条件两条描述互相确认合力为零。"
            }
          ]
        },
        {
          "name": "二力平衡条件",
          "expr": "F1 = F2",
          "when": "两个力作用在同一物体、同一直线上且方向相反。",
          "checks": [
            {
              "type": "numeric",
              "scenario": "桌面静止木块",
              "expr": "F1-F2",
              "ref": 0,
              "note": "平衡时两个反向力的代数和为零。"
            },
            {
              "type": "numeric",
              "scenario": "匀速拉动木块",
              "expr": "F1-F2",
              "ref": 0,
              "note": "匀速状态下水平方向合力为零。"
            },
            {
              "type": "scan",
              "scenario": "桌面静止木块",
              "var": "F2",
              "lo": 0,
              "hi": 100,
              "note": "若 F1 与 F2 同步等大变化，平衡条件仍成立。"
            }
          ]
        }
      ],
      "derivation": [
        "先画出物体所受力，确认两个力作用在同一物体上。",
        "检查两力是否在同一直线、方向相反且大小相等。",
        "沿选定方向计算代数和，等大反向时合力为零。",
        "依据合力为零，物体保持静止或匀速直线运动状态。"
      ],
      "errors": [
        {
          "wrong": "两个反向力大小相等时，把合力写成两力相加。",
          "wrong_expr": "F_net = F1+F2",
          "why": "方向相反的共线力应按选定正方向做代数相减；5 N 与 5 N 反向合力为零。",
          "caught_by": "数值代入",
          "trap_test": {
            "scenario": "桌面静止木块",
            "expr": "F1+F2",
            "ref": 0
          }
        },
        {
          "wrong": "认为合力为零就说明物体一定静止。",
          "why": "合力为零时物体保持原来的运动状态；原来运动的物体可继续做匀速直线运动。",
          "caught_by": "人工审核"
        }
      ],
      "example": {
        "stem": "木块在水平面上受到 8 N 向右拉力，并以 8 N 的摩擦力向左运动。判断水平方向合力和运动状态。",
        "solution": [
          "取向右为正方向，合力为 8-8=0 N。",
          "合力为零可保持已有运动状态；若木块原来匀速，则继续匀速直线运动。"
        ],
        "answer": "水平方向合力为 0 N；若原来匀速，将保持匀速直线运动。"
      },
      "prereq": [
        "force-02"
      ],
      "next": [
        "fmotion-02"
      ],
      "tags": [
        "二力平衡",
        "合力",
        "平衡条件",
        "受力分析"
      ]
    },
    {
      "id": "fmotion-02",
      "title": "牛顿第一定律",
      "level": "基础",
      "definition": "一切物体在没有受到外力作用时，总保持静止状态或匀速直线运动状态。现实中难以完全消除外力，实验通过减小阻力观察物体运动状态变化，从而理解惯性和力的作用。",
      "meaning": "惯性是物体保持原来运动状态的性质，质量越大通常越难改变运动状态。力不是维持运动的原因，而是改变运动状态的原因；当合力为零，物体可以静止，也可以保持原有速度做匀速直线运动。解释现象时要区分“有速度”和“有合力”。",
      "symbols": {
        "s": {
          "desc": "匀速直线运动通过的路程",
          "unit": "m"
        },
        "t": {
          "desc": "通过路程所用的时间",
          "unit": "s"
        },
        "v": {
          "desc": "匀速直线运动速度",
          "unit": "m/s"
        },
        "v1": {
          "desc": "运动开始时速度",
          "unit": "m/s"
        },
        "v2": {
          "desc": "一段时间后速度",
          "unit": "m/s"
        }
      },
      "scenarios": {
        "匀速小车": {
          "s": 50,
          "t": 5,
          "v": 10,
          "v1": 10,
          "v2": 10
        },
        "匀速传送带": {
          "s": 24,
          "t": 3,
          "v": 8,
          "v1": 8,
          "v2": 8
        }
      },
      "formulas": [
        {
          "name": "匀速直线运动的速度",
          "expr": "v = s/t",
          "when": "物体沿直线运动且速度大小不变，路程与计时区间匹配。",
          "checks": [
            {
              "type": "numeric",
              "scenario": "匀速小车",
              "expr": "s/t",
              "ref": 10,
              "note": "50 m÷5 s=10 m/s。"
            },
            {
              "type": "numeric",
              "scenario": "匀速传送带",
              "expr": "s/t",
              "ref": 8,
              "note": "24 m÷3 s=8 m/s。"
            },
            {
              "type": "direction",
              "scenario": "匀速小车",
              "var": "s",
              "lo": 10,
              "hi": 100,
              "expr": "s/t",
              "expect": "up",
              "note": "计时固定时，通过路程增大，计算的匀速速度增大。"
            },
            {
              "type": "scan",
              "scenario": "匀速小车",
              "var": "t",
              "lo": 0.1,
              "hi": 20,
              "note": "扫描正计时范围，速度计算稳定。"
            },
            {
              "type": "consistency",
              "scenario": "匀速小车",
              "expr": "s/t",
              "with": "fmotion-02|合力为零时速度保持不变",
              "with_expr": "v2",
              "target": "同一匀速运动的速度",
              "note": "由整段路程和时间测得的速度，与运动前后保持的速度读数复核。"
            }
          ]
        },
        {
          "name": "合力为零时速度保持不变",
          "expr": "v2 = v1",
          "when": "沿直线运动且合力为零；此式描述速度大小不变，方向也保持不变。",
          "checks": [
            {
              "type": "numeric",
              "scenario": "匀速小车",
              "expr": "v1",
              "ref": 10,
              "note": "匀速小车前后速度大小相同。"
            },
            {
              "type": "numeric",
              "scenario": "匀速传送带",
              "expr": "v1",
              "ref": 8,
              "note": "另一匀速运动情境中速度保持不变。"
            },
            {
              "type": "scan",
              "scenario": "匀速小车",
              "var": "v1",
              "lo": 0,
              "hi": 50,
              "note": "扫描非负初速度，合力为零时保持该速度。"
            }
          ]
        }
      ],
      "derivation": [
        "惯性使物体具有保持原有运动状态的倾向，不是额外施加在物体上的力。",
        "合力为零时，物体的运动状态不发生改变。",
        "若物体已沿直线匀速运动，则一段时间前后的速度相同。"
      ],
      "errors": [
        {
          "wrong": "把惯性说成物体继续运动的一个力。",
          "why": "惯性是物体本身的性质，不是力；分析速度改变仍要检查物体受到的合力。",
          "caught_by": "人工审核"
        },
        {
          "wrong": "速度已用 m/s 代入路程关系时，又额外乘 3.6，误把 km/h 换算重复做了一次。",
          "wrong_expr": "s = 3.6*v*t",
          "why": "匀速小车速度 10 m/s、时间 5 s，路程应为 50 m；再乘 3.6 会错算为 180 m。",
          "caught_by": "数值代入",
          "trap_test": {
            "scenario": "匀速小车",
            "expr": "3.6*v*t",
            "ref": 50
          }
        },
        {
          "wrong": "认为只有运动物体才有惯性，静止物体没有惯性。",
          "why": "惯性是所有物体的固有属性，静止物体也保持静止状态，质量越大惯性越大。",
          "caught_by": "人工审核"
        }
      ],
      "example": {
        "stem": "传送带使物体沿直线以 8 m/s 匀速运动 3 s，求路程，并说明合力为零时速度如何变化。",
        "solution": [
          "路程 s=vt=8×3=24 m。",
          "若合力为零，物体保持原来的匀速直线运动状态。"
        ],
        "answer": "路程为 24 m；合力为零时速度保持不变。"
      },
      "prereq": [
        "fmotion-01"
      ],
      "next": [
        "fmotion-03"
      ],
      "tags": [
        "牛顿第一定律",
        "惯性",
        "运动状态",
        "合力为零"
      ]
    },
    {
      "id": "fmotion-03",
      "title": "力与运动的关系",
      "level": "拓展",
      "definition": "合力会改变物体的运动状态。对质量不变、合力恒定的物体，合力大小与加速度大小满足 F_net=m*a；合力方向与加速度方向一致。该定量关系作为牛顿第二定律的拓展预览，不是初中本章的必背公式。",
      "meaning": "观察相同质量的小车受到不同合力时的运动变化，可发现合力越大，加速度越大；质量相同时，合力相同而质量更大，加速度更小。这里用 F_net=m*a 把趋势定量表达，要求质量不变、合力恒定且单位统一为 kg、N、m/s²。初中课程首先要求理解力能改变运动状态。",
      "symbols": {
        "F_net": {
          "desc": "物体所受合力大小",
          "unit": "N"
        },
        "m": {
          "desc": "物体质量",
          "unit": "kg"
        },
        "a": {
          "desc": "物体加速度大小",
          "unit": "m/s^2"
        },
        "dv": {
          "desc": "一段时间内速度变化量",
          "unit": "m/s"
        },
        "t": {
          "desc": "速度变化所用时间",
          "unit": "s"
        }
      },
      "scenarios": {
        "二千克小车": {
          "F_net": 4,
          "m": 2,
          "a": 2,
          "dv": 4,
          "t": 2
        },
        "五千克小车": {
          "F_net": 10,
          "m": 5,
          "a": 2,
          "dv": 3,
          "t": 1.5
        }
      },
      "formulas": [
        {
          "name": "恒定合力与加速度关系",
          "expr": "F_net = m*a",
          "when": "质量不变且合力恒定时；单位分别为 kg、m/s^2、N。",
          "checks": [
            {
              "type": "numeric",
              "scenario": "二千克小车",
              "expr": "m*a",
              "ref": 4,
              "note": "2 kg 小车加速度为 2 m/s²，合力大小为 4 N。 "
            },
            {
              "type": "numeric",
              "scenario": "五千克小车",
              "expr": "m*a",
              "ref": 10,
              "note": "5 kg 小车加速度为 2 m/s²，合力大小为 10 N。 "
            },
            {
              "type": "direction",
              "scenario": "二千克小车",
              "var": "a",
              "lo": 0.1,
              "hi": 10,
              "expr": "m*a",
