{
  "chapter": "压强和浮力",
  "order": 9,
  "intro": "按苏科版2024目录分为固体压强、液体压强、气体压强、浮力和浮沉判断；水银柱估算与静止液柱模型注明其适用条件。",
  "points": [
    {
      "id": "pressure-01",
      "title": "压强",
      "level": "基础",
      "definition": "压力是垂直作用在接触面上的力；压强表示单位面积上受到的压力，p=F/S。压力固定时受力面积越小，压强越大；比较不同情境时要先确认压力方向和接触面积。",
      "meaning": "压强能描述压力作用效果。计算固体压强时使用垂直接触面的压力和实际受力面积；不能把物体全部表面积当作受力面积。增大压力或减小受力面积通常会增大压强；单位 Pa 等于 N/m²。",
      "symbols": {
        "F": {
          "desc": "垂直接触面的压力",
          "unit": "N"
        },
        "S": {
          "desc": "受力面积",
          "unit": "m2"
        },
        "p": {
          "desc": "压强",
          "unit": "Pa"
        },
        "rho": {
          "desc": "液体密度",
          "unit": "kg/m^3"
        },
        "g": {
          "desc": "当地重力加速度",
          "unit": "N/kg"
        },
        "h": {
          "desc": "测点到液面的竖直深度",
          "unit": "m"
        }
      },
      "scenarios": {
        "窄底物体": {
          "F": 100,
          "S": 0.02,
          "p": 5000
        },
        "宽底物体": {
          "F": 200,
          "S": 0.04,
          "p": 5000
        },
        "水下10厘米": {
          "p": 1000,
          "rho": 1000,
          "g": 10,
          "h": 0.1,
          "S": 0.01,
          "F": 10
        },
        "水下20厘米": {
          "p": 2000,
          "rho": 1000,
          "g": 10,
          "h": 0.2,
          "S": 0.01,
          "F": 20
        }
      },
      "formulas": [
        {
          "name": "压力与受力面积求压强",
          "expr": "p = F/S",
          "when": "F 垂直接触面，F 用 N、S 用 m2，结果 p 用 Pa。",
          "checks": [
            {
              "type": "numeric",
              "scenario": "窄底物体",
              "expr": "F/S",
              "ref": 5000,
              "note": "100 N÷0.02 m2=5000 Pa。"
            },
            {
              "type": "numeric",
              "scenario": "宽底物体",
              "expr": "F/S",
              "ref": 5000,
              "note": "200 N÷0.04 m2=5000 Pa。"
            },
            {
              "type": "direction",
              "scenario": "窄底物体",
              "var": "S",
              "lo": 0.01,
              "hi": 0.1,
              "expr": "F/S",
              "expect": "down",
              "note": "压力固定时，受力面积增大，压强减小。"
            },
            {
              "type": "scan",
              "scenario": "窄底物体",
              "var": "S",
              "lo": 0.001,
              "hi": 1,
              "note": "扫描正面积范围，检查除法计算稳定。"
            },
            {
              "type": "consistency",
              "scenario": "窄底物体",
              "expr": "F/S",
              "with": "pressure-01|由压强和面积求压力",
              "with_expr": "F/S",
              "target": "同一接触面的压强",
              "note": "按压力面积比求压强，并以反算压力时的面积比核对数值。"
            }
          ]
        },
        {
          "name": "由压强和面积求压力",
          "expr": "F = p*S",
          "when": "压力垂直作用于面积 S，压强 p 均匀。",
          "checks": [
            {
              "type": "numeric",
              "scenario": "窄底物体",
              "expr": "p*S",
              "ref": 100,
              "note": "5000 Pa×0.02 m2=100 N。"
            },
            {
              "type": "numeric",
              "scenario": "宽底物体",
              "expr": "p*S",
              "ref": 200,
              "note": "5000 Pa×0.04 m2=200 N。"
            },
            {
              "type": "scan",
              "scenario": "窄底物体",
              "var": "S",
              "lo": 0,
              "hi": 1,
              "note": "扫描非负面积，反算的压力数值有限。"
            }
          ]
        }
      ],
      "derivation": [
        "确定垂直作用于接触面的压力 F。",
        "测量承受压力的面积 S 并统一为 m2。",
        "把 F 除以 S 得压强 p；也可由 p 和 S 反算压力。"
      ],
      "errors": [
        {
          "wrong": "把压强写成压力乘以面积。",
          "wrong_expr": "p = F*S",
          "why": "压强表示单位面积上的压力，应除以面积；F*S 的单位也不是 Pa。",
          "caught_by": "量纲一致性",
          "trap_test": {
            "scenario": "窄底物体",
            "expr": "F*S",
            "ref": 5000
          }
        },
        {
          "wrong": "把 cm2 换算成 m2 时只按 100 倍换算面积，少考虑了长度单位平方。",
          "wrong_expr": "p = F/(100*S)",
          "why": "1 m2=10 000 cm2；窄底面积 0.02 m2 对应 200 cm2，少换算 100 倍会把压强算小 100 倍。",
          "caught_by": "数值代入",
          "trap_test": {
            "scenario": "窄底物体",
            "expr": "F/(100*S)",
            "ref": 5000
          }
        },
        {
          "wrong": "认为受力面积越大，压力固定时压强也越大。",
          "why": "同一压力分摊到更大的受力面积上，单位面积承担的压力会减小，因此压强减小；压力和压强不能混为一个量。",
          "caught_by": "人工审核"
        }
      ],
      "example": {
        "stem": "重 100 N 的物体对水平地面的受力面积为 0.02 m2，求压强。",
        "solution": [
          "物体静止且水平面支撑时，压力大小为 100 N。",
          "p=F/S=100/0.02=5000 Pa。"
        ],
        "answer": "压强为 5000 Pa。"
      },
      "prereq": [
        "force-01"
      ],
      "next": [
        "pressure-02"
      ],
      "tags": [
        "压强",
