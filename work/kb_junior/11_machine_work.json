{
  "chapter": "简单机械和功",
  "order": 11,
  "intro": "按苏科版2024目录分别整理杠杆、滑轮、功、功率和机械效率；理想滑轮的省力与距离关系注明忽略摩擦等条件。",
  "points": [
    {
      "id": "machine-01",
      "title": "杠杆",
      "level": "基础",
      "definition": "杠杆是在力的作用下绕固定点转动的硬棒。杠杆平衡时，动力与动力臂的乘积等于阻力与阻力臂的乘积；两种力臂均为支点到力的作用线的垂直距离。",
      "meaning": "杠杆平衡条件可用于分析撬棒、剪刀和天平。先找支点，再确定力的作用线并作垂线段得到力臂；力臂不是支点到作用点的任意距离。改变动力臂或阻力臂会改变平衡所需的力，但不能凭杠杆长短直接判断省力。",
      "symbols": {
        "F1": {
          "desc": "动力大小",
          "unit": "N"
        },
        "l1": {
          "desc": "动力臂长度",
          "unit": "m"
        },
        "F2": {
          "desc": "阻力大小",
          "unit": "N"
        },
        "l2": {
          "desc": "阻力臂长度",
          "unit": "m"
        }
      },
      "scenarios": {
        "剪刀杠杆": {
          "F1": 20,
          "l1": 0.3,
          "F2": 30,
          "l2": 0.2
        },
        "撬棒杠杆": {
          "F1": 40,
          "l1": 0.2,
          "F2": 10,
          "l2": 0.8
        }
      },
      "formulas": [
        {
          "name": "杠杆平衡条件",
          "expr": "F1 = F2*l2/l1",
          "when": "杠杆静止平衡，l1、l2 是到支点的垂直力臂。",
          "checks": [
            {
              "type": "numeric",
              "scenario": "剪刀杠杆",
              "expr": "F2*l2/l1",
              "ref": 20,
              "note": "30 N×0.2 m÷0.3 m=20 N。"
            },
            {
              "type": "numeric",
              "scenario": "撬棒杠杆",
              "expr": "F2*l2/l1",
              "ref": 40,
              "note": "10 N×0.8 m÷0.2 m=40 N。"
            },
            {
              "type": "direction",
              "scenario": "剪刀杠杆",
              "var": "l1",
              "lo": 0.05,
              "hi": 1,
              "expr": "F2*l2/l1",
              "expect": "down",
              "note": "阻力与阻力臂固定时，动力臂越长，平衡所需动力越小。"
            },
            {
              "type": "scan",
              "scenario": "剪刀杠杆",
              "var": "l1",
              "lo": 0.001,
              "hi": 2,
              "note": "扫描正动力臂长度，力矩计算稳定。"
            },
            {
              "type": "consistency",
              "scenario": "剪刀杠杆",
              "expr": "F2*l2/l1",
              "with": "machine-01|由动力和力臂求平衡阻力",
              "with_expr": "F1",
              "target": "杠杆平衡所需的动力",
              "note": "按阻力和两力臂计算所需动力，再与杠杆情境记录的动力值核对。"
            }
          ]
        },
        {
          "name": "由动力和力臂求平衡阻力",
          "expr": "F2 = F1*l1/l2",
          "when": "已知动力、动力臂和非零阻力臂，杠杆处于平衡。",
          "checks": [
            {
              "type": "numeric",
              "scenario": "剪刀杠杆",
              "expr": "F1*l1/l2",
              "ref": 30,
              "note": "20×0.3÷0.2=30 N。"
            },
            {
              "type": "numeric",
              "scenario": "撬棒杠杆",
              "expr": "F1*l1/l2",
              "ref": 10,
              "note": "40×0.2÷0.8=10 N。"
            },
            {
              "type": "scan",
              "scenario": "剪刀杠杆",
              "var": "l2",
              "lo": 0.01,
              "hi": 2,
              "note": "扫描非零阻力臂，反算阻力不发生除零。"
            }
          ]
        }
      ],
      "derivation": [
        "从支点到动力作用线作垂线，得到动力臂 l1。",
        "从支点到阻力作用线作垂线，得到阻力臂 l2。",
        "杠杆静止平衡时，两侧力与各自力臂的乘积相等。",
        "根据已知的三个量，可解出第四个量。"
      ],
      "errors": [
        {
          "wrong": "把杠杆两端到支点的任意距离当成力臂。",
          "why": "力臂是支点到力的作用线的垂直距离；不一定等于杠杆上沿的长度。",
          "caught_by": "人工审核"
        },
        {
          "wrong": "把杠杆平衡条件写成动力与阻力直接相等。",
          "wrong_expr": "F1 = F2*l2/(2*l1)",
          "why": "平衡条件需要比较力与力臂的乘积；剪刀情境中动力应为 20 N，不能再多除以 2。",
          "caught_by": "数值代入",
          "trap_test": {
            "scenario": "剪刀杠杆",
            "expr": "F2*l2/(2*l1)",
            "ref": 20
          }
        }
      ],
      "example": {
        "stem": "撬棒阻力为 200 N，阻力臂为 0.1 m，动力臂为 1 m，求杠杆平衡所需动力。",
        "solution": [
          "F1=F2*l2/l1。",
          "F1=200×0.1÷1=20 N。"
        ],
        "answer": "动力为 20 N。"
      },
      "prereq": [
        "force-01"
      ],
      "next": [
        "machine-02"
      ],
      "tags": [
        "杠杆",
        "支点",
        "力臂",
        "杠杆平衡条件"
      ]
    },
    {
      "id": "machine-04",
      "title": "滑轮",
      "level": "基础",
      "definition": "定滑轮主要改变用力方向，理想情况下不省力；动滑轮可省力但需要拉动更长距离。由承重绳段数决定理想省力倍数，实际机械还要考虑摩擦和滑轮自重。",
      "meaning": "分析滑轮时先数承担动滑轮和重物的绳段，再判断每段绳的拉力与物体重力的关系。理想动滑轮省一半力时，拉绳距离约为重物上升高度的两倍，输入功与输出功相等；实际装置因摩擦等损耗，总输入功大于有用功。",
      "symbols": {
        "F_pull": {
          "desc": "拉绳所需的拉力",
          "unit": "N"
        },
        "G_load": {
          "desc": "被提升物体所受重力",
          "unit": "N"
        },
        "s_pull": {
          "desc": "自由端绳子移动的距离",
          "unit": "m"
        },
        "h_load": {
          "desc": "重物上升的高度",
          "unit": "m"
        },
        "W_in": {
          "desc": "输入的功",
          "unit": "J"
        },
        "W_out": {
          "desc": "提升重物所做的有用功",
          "unit": "J"
        }
      },
      "scenarios": {
        "理想动滑轮提升100牛": {
          "F_pull": 50,
          "G_load": 100,
          "s_pull": 2,
          "h_load": 1,
          "W_in": 100,
          "W_out": 100
        },
        "理想动滑轮提升200牛": {
          "F_pull": 100,
          "G_load": 200,
          "s_pull": 4,
          "h_load": 2,
          "W_in": 400,
          "W_out": 400
        }
      },
      "derivation": [
        "先判断使用定滑轮、动滑轮还是滑轮组，画出承重绳段。",
        "理想动滑轮中两段绳平均承担重物重力，所以拉力约为重力的一半。",
        "省力伴随距离增加；比较拉力乘绳端路程与重力乘重物上升高度，理想情况下两者相等。"
      ],
      "errors": [
        {
          "wrong": "使用理想动滑轮时只考虑省力，忘记拉绳距离也增加。",
          "wrong_expr": "s_pull = h_load",
          "why": "单动滑轮由两段绳承担重物，重物上升 1 m 时拉绳端约需移动 2 m。",
          "caught_by": "数值代入",
          "trap_test": {
            "scenario": "理想动滑轮提升100牛",
            "expr": "h_load",
            "ref": 2
          }
        },
        {
          "wrong": "认为实际滑轮组一定能省功。",
          "why": "实际装置有摩擦和自身质量，输入功通常大于有用功；机械可以省力但不能省功。",
          "caught_by": "人工审核"
        }
      ],
      "example": {
        "stem": "用理想动滑轮提升 200 N 重物 0.5 m，求拉力和拉绳距离。",
        "solution": [
          "理想单动滑轮由两段绳承重，拉力约为 200÷2=100 N。",
          "拉绳距离约为 2×0.5=1.0 m。",
          "输入功为 100×1.0=100 J，等于重物增加的有用功 200×0.5=100 J。"
        ],
        "answer": "拉力约 100 N，拉绳距离约 1.0 m。"
      },
      "prereq": [
        "machine-01"
      ],
      "next": [
        "machine-02"
      ],
      "tags": [
        "滑轮",
        "定滑轮",
        "动滑轮",
        "滑轮组",
        "机械效率"
      ],
      "formulas": [
        {
          "name": "理想动滑轮的拉力关系",
          "expr": "F_pull = G_load/2",
          "when": "单个理想动滑轮匀速提升重物，忽略滑轮自重、绳重和摩擦。",
          "checks": [
            {
              "type": "numeric",
              "scenario": "理想动滑轮提升100牛",
              "expr": "G_load/2",
              "ref": 50,
              "note": "两段绳承担 100 N 重物，每段拉力为 50 N。"
            },
            {
              "type": "numeric",
              "scenario": "理想动滑轮提升200牛",
              "expr": "G_load/2",
              "ref": 100,
              "note": "重物重力加倍，理想拉力也加倍。"
            },
            {
              "type": "direction",
              "scenario": "理想动滑轮提升100牛",
              "var": "G_load",
              "lo": 1,
              "hi": 1000,
              "expr": "G_load/2",
              "expect": "up",
              "note": "重物重力越大，理想拉力越大。"
            },
            {
              "type": "scan",
              "scenario": "理想动滑轮提升100牛",
              "var": "G_load",
              "lo": 0,
              "hi": 2000,
              "note": "扫描非负重力，理想拉力计算有限。"
            },
            {
              "type": "consistency",
              "scenario": "理想动滑轮提升100牛",
              "expr": "F_pull*s_pull",
              "with": "machine-04|理想动滑轮的距离关系",
              "with_expr": "G_load*h_load",
              "target": "输入功与有用功",
              "note": "省力同时拉绳距离变长，理想动滑轮的输入功和有用功相等。"
            }
          ]
        },
        {
          "name": "理想动滑轮的距离关系",
          "expr": "s_pull = 2*h_load",
          "when": "理想单动滑轮由两段绳承担重物，忽略绳伸长和摩擦。",
          "checks": [
            {
              "type": "numeric",
              "scenario": "理想动滑轮提升100牛",
              "expr": "2*h_load",
              "ref": 2,
              "note": "重物上升 1 m，拉绳端移动 2 m。"
            },
            {
              "type": "numeric",
              "scenario": "理想动滑轮提升200牛",
              "expr": "2*h_load",
              "ref": 4,
              "note": "重物上升 2 m，拉绳端移动 4 m。"
            },
            {
              "type": "direction",
              "scenario": "理想动滑轮提升100牛",
              "var": "h_load",
              "lo": 0.01,
              "hi": 10,
              "expr": "2*h_load",
              "expect": "up",
              "note": "重物上升高度增加时，拉绳端路程同步增加。"
            },
            {
              "type": "scan",
              "scenario": "理想动滑轮提升100牛",
              "var": "h_load",
              "lo": 0,
              "hi": 100,
              "note": "扫描非负上升高度，拉绳距离保持有限。"
            },
            {
              "type": "consistency",
              "scenario": "理想动滑轮提升100牛",
              "expr": "G_load*h_load",
              "with": "machine-04|理想动滑轮的拉力关系",
              "with_expr": "F_pull*s_pull",
              "target": "理想滑轮做功",
              "note": "由重力和上升高度计算输出功，与拉力和绳端距离计算输入功比较。"
            }
          ]
        }
      ]
    },
    {
      "id": "machine-02",
      "title": "功",
      "level": "基础",
      "definition": "功描述力对物体做功的过程。力和物体在力的方向上发生位移时，力对物体做功；在力与位移同方向的简单情形中，功等于力与沿力方向距离的乘积。",
      "meaning": "计算功时必须同时有力和沿力方向的位移：物体虽移动但力没有沿位移方向的分量时，不能直接用 W=Fs。力用 N、距离用 m，功的单位是 J。",
      "symbols": {
        "F": {
          "desc": "沿运动方向的作用力",
          "unit": "N"
        },
        "s": {
          "desc": "物体沿力方向通过的距离",
          "unit": "m"
        },
        "W": {
          "desc": "力所做的功",
          "unit": "J"
        },
        "t": {
          "desc": "做功所用时间",
          "unit": "s"
        },
        "P": {
          "desc": "功率",
          "unit": "W"
        }
      },
      "scenarios": {
        "抬起物体": {
          "F": 50,
          "s": 4,
          "W": 200,
          "t": 10,
          "P": 20
        },
        "拉动木箱": {
          "F": 100,
          "s": 2,
          "W": 200,
          "t": 5,
          "P": 40
        }
      },
      "formulas": [
        {
          "name": "力和沿力方向距离求功",
          "expr": "W = F*s",
          "when": "力与位移同方向，F 用 N、s 用 m。",
          "checks": [
            {
              "type": "numeric",
              "scenario": "抬起物体",
              "expr": "F*s",
              "ref": 200,
              "note": "50 N×4 m=200 J。"
            },
            {
              "type": "numeric",
              "scenario": "拉动木箱",
              "expr": "F*s",
              "ref": 200,
              "note": "100 N×2 m=200 J。"
            },
            {
              "type": "direction",
              "scenario": "抬起物体",
              "var": "s",
              "lo": 0,
              "hi": 10,
              "expr": "F*s",
              "expect": "up",
              "note": "力固定且同向时，移动距离越长，做功越多。"
            },
            {
              "type": "scan",
              "scenario": "抬起物体",
              "var": "s",
              "lo": 0,
              "hi": 100,
              "note": "扫描非负距离，做功计算保持稳定。"
            },
            {
              "type": "consistency",
              "scenario": "抬起物体",
              "expr": "F*s",
              "with": "machine-05|由功和时间求功率",
              "with_expr": "P*t",
              "target": "同一段过程的功",
              "note": "用力乘距离求功，再由该过程的功率乘时间独立核对。"
            }
          ]
        }
      ],
      "derivation": [
        "确认作用力是否使物体沿力的方向移动。",
        "若力和位移同向，用 W=F*s 求功。",
        "记录完成这段功所用的时间。",
        "用 P=W/t 比较做功快慢。"
      ],
      "errors": [
        {
          "wrong": "把功写成力除以移动距离。",
          "wrong_expr": "W = F/s",
          "why": "功等于力与沿力方向位移的乘积，不是除法；单位由 N×m 得到 J，位移方向与力垂直时该力不做功。",
          "caught_by": "量纲一致性",
          "trap_test": {
            "scenario": "抬起物体",
            "expr": "F/s",
            "ref": 200
          }
        },
        {
          "wrong": "位移已换算为 m 后，又按 cm 单位额外缩小 100 倍。",
          "wrong_expr": "W = F*s/100",
          "why": "抬起物体的位移已按 4 m 代入，不能再除以 100；否则 200 J 会被算成 2 J。",
          "caught_by": "数值代入",
          "trap_test": {
            "scenario": "抬起物体",
            "expr": "F*s/100",
            "ref": 200
          }
        },
        {
          "wrong": "物体受力但没有沿力方向移动，仍认为该力做了功。",
          "why": "做功要求力对物体产生沿力方向的位移；只有力却没有相应位移，或物体运动方向与力垂直，都不能据此认为该力做了功。",
          "caught_by": "人工审核"
        }
      ],
      "example": {
        "stem": "用 100 N 的水平力拉木箱移动 2 m，历时 5 s，求功和功率。",
        "solution": [
          "W=Fs=100×2=200 J。",
          "P=W/t=200/5=40 W。"
        ],
        "answer": "做功 200 J，功率 40 W。"
      },
      "prereq": [
        "motion-01"
      ],
      "next": [
        "machine-03"
      ],
      "tags": [
        "功",
        "力",
        "位移",
        "焦耳"
      ]
    },
    {
      "id": "machine-05",
      "title": "功率",
      "level": "基础",
      "definition": "功率表示做功的快慢，等于一段过程中所做的功与所用时间之比。相同的功用时越短，功率越大；相同时间内做功越多，功率越大。",
      "meaning": "比较机器做功快慢时要比较功率，而不是只看总功。计算时功用 J、时间用 s，功率单位为 W；大型设备也常用 kW。功率是单位时间完成的功，数值并不等于总功；功率换算时 1 kW=1000 W，不能漏写时间单位。",
      "symbols": {
        "F": {
          "desc": "沿运动方向的作用力",
          "unit": "N"
        },
        "s": {
          "desc": "物体沿力方向通过的距离",
          "unit": "m"
        },
        "W": {
          "desc": "力所做的功",
          "unit": "J"
        },
        "t": {
          "desc": "做功所用时间",
          "unit": "s"
        },
        "P": {
          "desc": "功率",
          "unit": "W"
        }
      },
      "scenarios": {
        "抬起物体": {
          "F": 50,
          "s": 4,
          "W": 200,
          "t": 10,
          "P": 20
        },
        "拉动木箱": {
          "F": 100,
          "s": 2,
          "W": 200,
          "t": 5,
          "P": 40
        }
      },
      "formulas": [
        {
          "name": "由功和时间求功率",
          "expr": "P = W/t",
          "when": "W 是同一时间段内完成的功，t 大于零；功率单位为 W。",
          "checks": [
