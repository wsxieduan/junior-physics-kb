            {
              "type": "numeric",
              "scenario": "拉动木箱",
              "expr": "W/t",
              "ref": 40,
              "note": "200 J 的功在 5 s 内完成，功率为 40 W。"
            },
            {
              "type": "direction",
              "scenario": "抬起物体",
              "var": "W",
              "lo": 10,
              "hi": 1000,
              "expr": "W/t",
              "expect": "up",
              "note": "时间固定时，完成的功越多，功率越大。"
            },
            {
              "type": "scan",
              "scenario": "抬起物体",
              "var": "t",
              "lo": 0.1,
              "hi": 1000,
              "note": "扫描正时间范围，功率计算保持有限。"
            },
