{
  "chapter": "机械能和内能",
  "order": 12,
  "intro": "用动能、重力势能和机械能描述运动与位置相关的能量，并以比热容关系定量分析热传递引起的内能变化。",
  "points": [
    {
      "id": "energy-01",
      "title": "动能、重力势能与机械能",
      "level": "基础",
      "definition": "物体由于运动而具有的能量叫动能，动能与物体质量和速度有关；物体由于被举高而具有的能量叫重力势能，与质量和高度有关。动能与势能统称机械能。",
      "meaning": "同一参考高度下，质量相同的物体速度越大，动能越大；速度相同而质量越大，动能越大。重力势能的大小与选定零势能参考面有关。机械能可在不同形式间相互转化；有摩擦等阻力时，部分机械能会转化为内能，不能不说明条件就断言机械能守恒。",
      "symbols": {
        "m": {"desc": "物体质量", "unit": "kg"},
        "v": {"desc": "物体速度大小", "unit": "m/s"},
        "Ek": {"desc": "物体动能", "unit": "J"},
        "g": {"desc": "当地重力加速度", "unit": "N/kg"},
        "h": {"desc": "相对选定参考面的高度", "unit": "m"},
        "Ep": {"desc": "物体重力势能", "unit": "J"},
        "Em": {"desc": "物体机械能，等于动能和重力势能之和", "unit": "J"}
      },
      "scenarios": {
        "高处小球": {"m": 2, "v": 3, "Ek": 9, "g": 10, "h": 5, "Ep": 100, "Em": 109},
        "抛起物体": {"m": 1, "v": 4, "Ek": 8, "g": 10, "h": 3, "Ep": 30, "Em": 38}
      },
      "formulas": [
        {
          "name": "物体动能",
          "expr": "Ek = 0.5*m*v^2",
          "when": "适用于物体平动的动能计算，m 用 kg、v 用 m/s。",
          "checks": [
            {"type": "numeric", "scenario": "高处小球", "expr": "0.5*m*v^2", "ref": 9, "note": "0.5×2×3^2=9 J。"},
            {"type": "numeric", "scenario": "抛起物体", "expr": "0.5*m*v^2", "ref": 8, "note": "0.5×1×4^2=8 J。"},
            {"type": "direction", "scenario": "高处小球", "var": "v", "lo": 0, "hi": 20, "expr": "0.5*m*v^2", "expect": "up", "note": "质量固定时，速度增大，动能按速度平方增大。"},
            {"type": "scan", "scenario": "高处小球", "var": "v", "lo": 0, "hi": 100, "note": "扫描非负速度，动能保持非负且有限。"}
          ]
        },
        {
          "name": "物体重力势能",
          "expr": "Ep = m*g*h",
          "when": "h 从选定参考面竖直量起，g 取当地值。",
          "checks": [
            {"type": "numeric", "scenario": "高处小球", "expr": "m*g*h", "ref": 100, "note": "2 kg×10 N/kg×5 m=100 J。"},
            {"type": "numeric", "scenario": "抛起物体", "expr": "m*g*h", "ref": 30, "note": "1 kg×10 N/kg×3 m=30 J。"},
            {"type": "direction", "scenario": "高处小球", "var": "h", "lo": 0, "hi": 20, "expr": "m*g*h", "expect": "up", "note": "质量和 g 固定时，高度增大，重力势能增大。"},
            {"type": "scan", "scenario": "高处小球", "var": "h", "lo": 0, "hi": 100, "note": "扫描参考面以上的非负高度。"}
          ]
        },
        {
          "name": "动能和重力势能组成机械能",
          "expr": "Em = Ek+Ep",
          "when": "本式中的机械能只计动能与重力势能，参考高度须一致。",
          "checks": [
            {"type": "numeric", "scenario": "高处小球", "expr": "Ek+Ep", "ref": 109, "note": "9 J+100 J=109 J。"},
            {"type": "numeric", "scenario": "抛起物体", "expr": "Ek+Ep", "ref": 38, "note": "8 J+30 J=38 J。"},
            {"type": "consistency", "scenario": "高处小球", "expr": "Ek+Ep", "with": "energy-01|机械能数值记录", "with_expr": "Em", "target": "小球的机械能", "note": "分别计算动能和势能再求和，与情境中机械能记录值核对。"},
            {"type": "scan", "scenario": "高处小球", "var": "Ek", "lo": 0, "hi": 10000, "note": "扫描非负动能，机械能总量有限。"}
          ]
        },
        {
          "name": "机械能数值记录",
          "expr": "Em = Ek+Ep",
          "when": "机械能按动能与重力势能之和记录。",
          "checks": [
            {"type": "numeric", "scenario": "高处小球", "expr": "Ek+Ep", "ref": 109, "note": "记录值应与动能和重力势能之和一致。"},
            {"type": "numeric", "scenario": "抛起物体", "expr": "Ek+Ep", "ref": 38, "note": "第二情境复算机械能总量。"},
            {"type": "scan", "scenario": "高处小球", "var": "Ep", "lo": 0, "hi": 10000, "note": "扫描非负势能，机械能记录保持有限。"}
          ]
        }
      ],
      "derivation": ["物体运动时具有动能，计算时使用质量和速度。", "相对参考面被举高的物体具有重力势能，计算时使用质量、g 和高度。", "把动能与重力势能相加，得到该参考面下的机械能。", "分析能量转化时，检查摩擦等因素是否使机械能转化为内能。"],
      "errors": [
        {"wrong": "把动能写成质量与速度的一次方相乘，漏掉速度平方和二分之一。", "wrong_expr": "Ek = m*v", "why": "动能的单位应为 J，m*v 的单位是 kg·m/s；量纲与数值关系都不符。", "caught_by": "量纲一致性", "trap_test": {"scenario": "高处小球", "expr": "m*v", "ref": 9}},
        {"wrong": "写动能公式时漏掉系数二分之一，只保留质量乘速度平方。", "wrong_expr": "Ek = m*v^2", "why": "高处小球的动能为 0.5×2×3^2=9 J；漏掉二分之一会得到 18 J，量纲仍正确但数值翻倍。", "caught_by": "数值代入", "trap_test": {"scenario": "高处小球", "expr": "m*v^2", "ref": 9}},
        {"wrong": "认为物体高度变化时重力势能与参考面无关。", "why": "重力势能数值依赖所选零势能参考面；比较同一过程能量变化时要保持参考面一致。", "caught_by": "人工审核"}
      ],
      "example": {"stem": "质量 2 kg 的小球以 3 m/s 运动，并位于参考面上方 5 m，取 g=10 N/kg，求机械能。", "solution": ["动能 Ek=0.5×2×3^2=9 J。", "重力势能 Ep=2×10×5=100 J。", "机械能 Em=9+100=109 J。"], "answer": "机械能为 109 J。"},
      "prereq": ["motion-01", "force-01"],
      "next": ["energy-02"],
      "tags": ["动能", "重力势能", "机械能", "能量转化"]
    },
    {
      "id": "energy-02",
      "title": "内能、热传递与比热容",
      "level": "基础",
      "definition": "物体内部大量粒子的无规则运动和相互作用所具有的能量叫内能。热传递可以改变物体内能；在没有物态变化的加热过程中，物体吸收的热量与质量、比热容和温度升高量有关。",
      "meaning": "比热容表示单位质量的某种物质温度升高 1℃ 时吸收热量的多少，单位为 J/kg/℃。同样质量、同样升温条件下，比热容较大的物质需要吸收更多热量。使用公式时要把温度变化量取为升高的摄氏度数，不能将摄氏温度本身直接代替温差。",
      "symbols": {
        "Q": {"desc": "物体吸收的热量", "unit": "J"},
        "c_h": {"desc": "物质比热容", "unit": "J/kg/℃"},
        "m": {"desc": "物体质量", "unit": "kg"},
        "dT": {"desc": "物体升高的温度", "unit": "℃"}
      },
      "scenarios": {
        "半千克水升温10度": {"Q": 21000, "c_h": 4200, "m": 0.5, "dT": 10},
        "两百克水升温5度": {"Q": 4200, "c_h": 4200, "m": 0.2, "dT": 5}
      },
      "formulas": [
        {
          "name": "加热温度变化时的吸热量",
          "expr": "Q = c_h*m*dT",
          "when": "无物态变化、比热容近似不变，dT 为温升，单位 ℃。",
          "checks": [
            {"type": "numeric", "scenario": "半千克水升温10度", "expr": "c_h*m*dT", "ref": 21000, "note": "4200×0.5×10=21 000 J。"},
            {"type": "numeric", "scenario": "两百克水升温5度", "expr": "c_h*m*dT", "ref": 4200, "note": "4200×0.2×5=4 200 J。"},
            {"type": "direction", "scenario": "半千克水升温10度", "var": "dT", "lo": 0, "hi": 50, "expr": "c_h*m*dT", "expect": "up", "note": "其他条件不变时，温升越大，吸收热量越多。"},
            {"type": "scan", "scenario": "半千克水升温10度", "var": "dT", "lo": 0, "hi": 100, "note": "扫描非负温升，吸热量计算保持线性。"},
            {"type": "consistency", "scenario": "半千克水升温10度", "expr": "c_h*m*dT", "with": "energy-02|由吸热量求比热容", "with_expr": "Q", "target": "加热水的吸热量", "note": "由比热容、质量和温升预测热量，并与给定热量反算情境复核。"}
          ]
        },
        {
          "name": "由吸热量求比热容",
          "expr": "c_h = Q/(m*dT)",
          "when": "样品无物态变化，吸收热量 Q、质量 m 和温升 dT 已知。",
          "checks": [
            {"type": "numeric", "scenario": "半千克水升温10度", "expr": "Q/(m*dT)", "ref": 4200, "note": "21 000÷(0.5×10)=4200 J/kg/℃。"},
            {"type": "numeric", "scenario": "两百克水升温5度", "expr": "Q/(m*dT)", "ref": 4200, "note": "4 200÷(0.2×5)=4200 J/kg/℃。"},
            {"type": "scan", "scenario": "半千克水升温10度", "var": "m", "lo": 0.01, "hi": 10, "note": "扫描正质量，反算比热容避免除零。"}
          ]
        }
      ],
      "derivation": ["记录被加热物体质量 m 和比热容 c_h。", "测量加热前后温度，求温升 dT。", "在无物态变化条件下，用 Q=c_h*m*dT 求吸收热量。", "实验中还要考虑容器吸热和散热等误差来源。"],
      "errors": [
        {"wrong": "计算吸热量时漏掉物体质量。", "wrong_expr": "Q = c_h*dT", "why": "比热容描述单位质量的吸热量，整块物体还要乘质量；半千克水升温 10℃ 吸热 21 000 J。", "caught_by": "数值代入", "trap_test": {"scenario": "半千克水升温10度", "expr": "c_h*dT", "ref": 21000}},
        {"wrong": "用末温代替温升，并在温度不变或发生物态变化时直接套用本式。", "why": "本式需要温度变化量，且适用于比热容近似不变、没有物态变化的过程；相变时需另行分析。", "caught_by": "人工审核"}
      ],
      "example": {"stem": "0.5 kg 的水温度升高 10℃，水的比热容取 4200 J/kg/℃，求吸收热量。", "solution": ["Q=c_h*m*dT。", "Q=4200×0.5×10=21 000 J。"], "answer": "水吸收 21 000 J 热量。"},
      "prereq": ["state-01"],
      "next": [],
      "tags": ["内能", "热传递", "比热容", "热量", "温升"]
    }
  ]
}
