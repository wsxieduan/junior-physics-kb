{
  "chapter": "机械能和内能",
  "order": 12,
  "intro": "按苏科版2024目录分为机械能、内能与热传递、物质比热容、机械能和内能相互转化；能量平衡均注明系统边界和散热条件。",
  "points": [
    {
      "id": "energy-01",
      "title": "机械能",
      "level": "基础",
      "definition": "物体由于运动而具有动能，由于被举高而具有重力势能；动能和重力势能之和称为机械能。机械能大小与质量、速度、高度及所选参考面有关。",
      "meaning": "动能随速度增大而增大，重力势能随所选参考面以上高度增大而增大。机械能在运动和相互作用中可以相互转化；只有在适用条件满足时，机械能才守恒。计算重力势能时要说明参考面，不能把任意零高度说成绝对位置。",
      "symbols": {
        "m": {
          "desc": "物体质量",
          "unit": "kg"
        },
        "v": {
          "desc": "物体速度大小",
          "unit": "m/s"
        },
        "Ek": {
          "desc": "物体动能",
          "unit": "J"
        },
        "g": {
          "desc": "当地重力加速度",
          "unit": "N/kg"
        },
        "h": {
          "desc": "相对选定参考面的高度",
          "unit": "m"
        },
        "Ep": {
          "desc": "物体重力势能",
          "unit": "J"
        },
        "Em": {
          "desc": "物体机械能，等于动能和重力势能之和",
          "unit": "J"
        },
        "Q": {
          "desc": "物体吸收的热量",
          "unit": "J"
        },
        "c_h": {
          "desc": "物质比热容",
          "unit": "J/kg/℃"
        },
        "dT": {
          "desc": "物体升高的温度",
          "unit": "℃"
        }
      },
      "scenarios": {
        "高处小球": {
          "m": 2,
          "v": 3,
          "Ek": 9,
          "g": 10,
          "h": 5,
          "Ep": 100,
          "Em": 109
        },
        "抛起物体": {
          "m": 1,
          "v": 4,
          "Ek": 8,
          "g": 10,
          "h": 3,
          "Ep": 30,
          "Em": 38
        },
        "半千克水升温10度": {
          "Q": 21000,
          "c_h": 4200,
          "m": 0.5,
          "dT": 10
        },
        "两百克水升温5度": {
          "Q": 4200,
          "c_h": 4200,
          "m": 0.2,
          "dT": 5
        }
      },
      "formulas": [
        {
          "name": "物体动能",
          "expr": "Ek = 0.5*m*v^2",
          "when": "适用于物体平动的动能计算，m 用 kg、v 用 m/s。",
          "checks": [
            {
              "type": "numeric",
              "scenario": "高处小球",
              "expr": "0.5*m*v^2",
              "ref": 9,
              "note": "0.5×2×3^2=9 J。"
            },
            {
              "type": "numeric",
              "scenario": "抛起物体",
              "expr": "0.5*m*v^2",
              "ref": 8,
              "note": "0.5×1×4^2=8 J。"
            },
            {
              "type": "direction",
              "scenario": "高处小球",
              "var": "v",
              "lo": 0,
              "hi": 20,
              "expr": "0.5*m*v^2",
              "expect": "up",
              "note": "质量固定时，速度增大，动能按速度平方增大。"
            },
            {
              "type": "scan",
              "scenario": "高处小球",
              "var": "v",
              "lo": 0,
              "hi": 100,
              "note": "扫描非负速度，动能保持非负且有限。"
            }
          ]
        },
        {
          "name": "物体重力势能",
          "expr": "Ep = m*g*h",
          "when": "h 从选定参考面竖直量起，g 取当地值。",
          "checks": [
            {
              "type": "numeric",
              "scenario": "高处小球",
              "expr": "m*g*h",
              "ref": 100,
              "note": "2 kg×10 N/kg×5 m=100 J。"
            },
            {
              "type": "numeric",
              "scenario": "抛起物体",
              "expr": "m*g*h",
              "ref": 30,
              "note": "1 kg×10 N/kg×3 m=30 J。"
            },
            {
              "type": "direction",
              "scenario": "高处小球",
              "var": "h",
              "lo": 0,
              "hi": 20,
              "expr": "m*g*h",
              "expect": "up",
              "note": "质量和 g 固定时，高度增大，重力势能增大。"
            },
            {
              "type": "scan",
              "scenario": "高处小球",
              "var": "h",
              "lo": 0,
              "hi": 100,
              "note": "扫描参考面以上的非负高度。"
            }
          ]
        },
        {
          "name": "动能和重力势能组成机械能",
          "expr": "Em = Ek+Ep",
          "when": "本式中的机械能只计动能与重力势能，参考高度须一致。",
          "checks": [
            {
              "type": "numeric",
              "scenario": "高处小球",
              "expr": "Ek+Ep",
              "ref": 109,
              "note": "9 J+100 J=109 J。"
            },
            {
              "type": "numeric",
              "scenario": "抛起物体",
              "expr": "Ek+Ep",
              "ref": 38,
              "note": "8 J+30 J=38 J。"
            },
            {
              "type": "scan",
              "scenario": "高处小球",
              "var": "Ek",
              "lo": 0,
              "hi": 10000,
              "note": "扫描非负动能，机械能总量有限。"
            }
          ]
        },
        {
          "name": "由速度和高度直接求机械能",
          "expr": "Em = 0.5*m*v^2+m*g*h",
          "when": "同一物体相对同一参考面计重力势能，机械能只包含动能和重力势能。",
          "checks": [
            {
              "type": "numeric",
              "scenario": "高处小球",
              "expr": "0.5*m*v^2+m*g*h",
              "ref": 109,
              "note": "直接代入质量、速度和高度，得到 9 J+100 J=109 J。"
            },
            {
              "type": "numeric",
              "scenario": "抛起物体",
              "expr": "0.5*m*v^2+m*g*h",
              "ref": 38,
              "note": "直接代入得 8 J+30 J=38 J，与该情境机械能相符。"
            },
            {
              "type": "direction",
              "scenario": "高处小球",
              "var": "h",
              "lo": 0,
              "hi": 20,
              "expr": "0.5*m*v^2+m*g*h",
              "expect": "up",
              "note": "速度不变、参考面固定时，升高物体会增加重力势能和机械能。"
            },
            {
              "type": "scan",
              "scenario": "高处小球",
              "var": "h",
              "lo": 0,
              "hi": 100,
              "note": "扫描参考面以上高度，直接计算的机械能保持有限。"
            },
            {
              "type": "consistency",
              "scenario": "高处小球",
              "expr": "0.5*m*v^2+m*g*h",
              "with": "energy-01|动能和重力势能组成机械能",
              "with_expr": "Ek+Ep",
              "target": "同一物体的机械能",
              "note": "将质量、速度、高度一次代入，与先分别求动能和重力势能再相加的路径互证。"
            }
          ]
        }
      ],
      "derivation": [
        "物体运动时具有动能，计算时使用质量和速度。",
        "相对参考面被举高的物体具有重力势能，计算时使用质量、g 和高度。",
        "把动能与重力势能相加，得到该参考面下的机械能。",
        "分析能量转化时，检查摩擦等因素是否使机械能转化为内能。"
      ],
      "errors": [
        {
          "wrong": "把动能写成质量与速度的一次方相乘，漏掉速度平方和二分之一。",
          "wrong_expr": "Ek = m*v",
          "why": "动能的单位应为 J，m*v 的单位是 kg·m/s；量纲与数值关系都不符。",
          "caught_by": "量纲一致性",
          "trap_test": {
            "scenario": "高处小球",
            "expr": "m*v",
            "ref": 9
          }
        },
        {
          "wrong": "写动能公式时漏掉系数二分之一，只保留质量乘速度平方。",
          "wrong_expr": "Ek = m*v^2",
          "why": "高处小球的动能为 0.5×2×3^2=9 J；漏掉二分之一会得到 18 J，量纲仍正确但数值翻倍。",
          "caught_by": "数值代入",
          "trap_test": {
            "scenario": "高处小球",
            "expr": "m*v^2",
            "ref": 9
          }
        },
        {
          "wrong": "认为物体高度变化时重力势能与参考面无关。",
          "why": "重力势能数值依赖所选零势能参考面；比较同一过程能量变化时要保持参考面一致。",
          "caught_by": "人工审核"
        }
      ],
      "example": {
        "stem": "质量 2 kg 的小球以 3 m/s 运动，并位于参考面上方 5 m，取 g=10 N/kg，求机械能。",
        "solution": [
          "动能 Ek=0.5×2×3^2=9 J。",
          "重力势能 Ep=2×10×5=100 J。",
          "机械能 Em=9+100=109 J。"
        ],
        "answer": "机械能为 109 J。"
      },
      "prereq": [
        "motion-01",
        "force-01"
      ],
      "next": [
        "energy-02"
      ],
      "tags": [
        "机械能",
        "动能",
        "重力势能",
        "机械能转化"
      ]
    },
    {
      "id": "energy-03",
      "title": "内能 热传递",
      "level": "基础",
      "definition": "物体内部所有分子无规则运动的动能及分子相互作用势能的总和称为内能。热传递是内能改变的一种方式，能量从温度较高的物体传向温度较低的物体，直到达到热平衡。",
      "meaning": "热量是热传递过程中传递的能量，不是物体“含有”的一种物质。忽略与外界的能量交换和散失时，高温物体放出的热量等于低温物体吸收的热量；实际实验需要考虑容器、温度计和环境带走的能量。用水的比热容可估算吸热量，再与热平衡的能量账目核对。",
      "symbols": {
        "Q_lost": {
          "desc": "高温物体放出的热量大小",
          "unit": "J"
        },
        "Q_gained": {
          "desc": "低温物体吸收的热量",
          "unit": "J"
        },
        "c_h": {
          "desc": "被加热物质的比热容",
          "unit": "J/kg/℃"
        },
        "m": {
          "desc": "被加热物质质量",
          "unit": "kg"
        },
        "dT": {
          "desc": "被加热物质的温升",
          "unit": "℃"
        }
      },
      "scenarios": {
        "水吸热与热水放热": {
          "Q_lost": 42000,
          "Q_gained": 42000,
          "c_h": 4200,
          "m": 0.2,
          "dT": 50
        },
        "混合水热交换": {
          "Q_lost": 84000,
          "Q_gained": 84000,
          "c_h": 4200,
          "m": 0.4,
          "dT": 50
        }
      },
      "formulas": [
        {
          "name": "绝热热交换中的放热吸热平衡",
          "expr": "Q_lost = Q_gained",
          "when": "把参与热交换的物体作为近似绝热系统，忽略向环境、容器等散失的能量。",
          "checks": [
            {
              "type": "numeric",
              "scenario": "水吸热与热水放热",
              "expr": "Q_gained",
              "ref": 42000,
              "note": "近似绝热时，热水放出 42 000 J，冷水吸收相同热量。 "
            },
            {
              "type": "numeric",
              "scenario": "混合水热交换",
              "expr": "Q_gained",
              "ref": 84000,
              "note": "另一组热平衡情境中放热量和吸热量相同。 "
            },
            {
              "type": "direction",
              "scenario": "水吸热与热水放热",
              "var": "Q_lost",
              "lo": 0,
              "hi": 200000,
              "expr": "Q_lost",
              "expect": "up",
              "note": "理想热平衡情境中放热量增加，吸热量按能量平衡同步增加。 "
            },
            {
              "type": "scan",
              "scenario": "水吸热与热水放热",
              "var": "Q_lost",
              "lo": 0,
              "hi": 1000000,
              "note": "扫描非负热量，守恒关系保持有限。 "
            },
            {
              "type": "consistency",
              "scenario": "水吸热与热水放热",
              "expr": "Q_gained",
              "with": "energy-02|加热温度变化时的吸热量",
              "with_expr": "c_h*m*dT",
              "target": "水吸收的热量",
              "note": "热平衡账目中的吸热量，与用水的比热容、质量和温升计算的热量互证。 "
            }
          ]
        }
      ],
      "derivation": [
        "确定热交换系统边界，并判断是否可近似忽略向环境散热。",
        "记录高温物体放热量和低温物体吸热量的大小。",
        "在近似绝热的系统内，两者大小相等；实际实验可将差值视作热损失与测量误差分析。"
      ],
      "errors": [
        {
          "wrong": "在忽略散热的热平衡问题中把吸热量误写成放热量的两倍。",
          "wrong_expr": "Q_lost = 2*Q_gained",
          "why": "封闭近似绝热系统的能量账目应相等；额外乘 2 会破坏热量平衡。",
          "caught_by": "数值代入",
          "trap_test": {
            "scenario": "水吸热与热水放热",
            "expr": "2*Q_gained",
            "ref": 42000
          }
        },
        {
          "wrong": "认为热量是物体本身储存的一种物质。",
          "why": "热量描述热传递过程中转移的能量；物体具有内能，而不是“含有热量”。",
          "caught_by": "人工审核"
        }
      ],
      "example": {
        "stem": "忽略散热时，一块热金属放出 600 J 热量给水，水吸收多少热量？",
        "solution": [
          "把金属和水作为近似绝热系统。",
          "金属放出的热量等于水吸收的热量。"
        ],
        "answer": "水吸收约 600 J。"
      },
      "prereq": [
        "energy-01"
      ],
      "next": [
        "energy-02",
        "energy-04"
      ],
      "tags": [
        "内能",
        "热传递",
        "吸热",
        "放热",
        "热平衡"
      ]
    },
    {
