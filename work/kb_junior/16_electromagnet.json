    {
      "id": "magnet-03",
      "title": "磁场对电流的作用与电动机",
      "level": "基础",
      "definition": "通电导体放在磁场中会受到磁场的作用力；改变电流方向或磁场方向，导体受力方向会改变。电动机利用这一作用使线圈转动，把输入的电能转化为机械能，同时也会有一部分能量转化为内能。",
      "meaning": "判断通电导体的运动方向时，要同时考虑电流方向和磁场方向，不能只看其中一个。磁场力的大小还受电流、磁场和导体等因素影响，初中阶段主要通过实验辨认方向，不把未学的磁场力定量公式当作必背规律。若电动机带动重物匀速上升，可用已学的功和功率关系估算机械输出；这是机械输出的计算，不是磁场力定律。",
      "symbols": {
        "F_out": {
          "desc": "电动机对负载所做功对应的平均作用力",
          "unit": "N"
        },
        "s_out": {
          "desc": "负载沿力方向移动的距离",
          "unit": "m"
        },
        "W_out": {
          "desc": "电动机输出的机械功",
          "unit": "J"
        },
        "t_run": {
          "desc": "电动机工作时间",
          "unit": "s"
        },
        "P_out": {
          "desc": "电动机输出的平均机械功率",
          "unit": "W"
        }
      },
      "scenarios": {
        "电动机提升重物一": {
          "F_out": 200,
          "s_out": 3,
          "W_out": 600,
          "t_run": 10,
          "P_out": 60
        },
        "电动机提升重物二": {
          "F_out": 500,
          "s_out": 2,
          "W_out": 1000,
          "t_run": 20,
          "P_out": 50
