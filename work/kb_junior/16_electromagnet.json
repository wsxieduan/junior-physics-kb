{
  "chapter": "电和磁",
  "order": 16,
  "intro": "理解通电导体周围的磁场、电磁铁与电磁感应；定量公式只处理线圈电路中已知电压、电阻后的电流，不虚构磁场强度或感应电压预测公式。",
  "points": [
    {
      "id": "magnet-01",
      "title": "磁体、磁场与电流的磁场",
      "level": "基础",
      "definition": "磁体周围存在磁场，磁极间会相互作用；磁场方向可用小磁针静止时北极所指方向描述。通电导线和通电螺线管周围也会产生磁场，线圈中插入铁芯可制成电磁铁。",
      "meaning": "本节把磁体的磁场和电流的磁效应连起来看：磁体或电流都能建立磁场，磁场可对磁针、磁体等产生作用。通电螺线管的磁极方向与电流方向有关；研究电磁铁强弱时要控制铁芯和线圈匝数等条件。线圈电流可以按欧姆定律计算，但电流数值不是磁场强弱的直接刻度。",
      "symbols": {
        "Uc": {
          "desc": "电磁铁线圈两端电压",
          "unit": "V"
        },
        "Ic": {
          "desc": "通过电磁铁线圈的电流",
          "unit": "A"
        },
        "Rc": {
          "desc": "线圈电阻",
          "unit": "Ω"
        },
        "N": {
          "desc": "线圈匝数，按匝计数",
          "unit": "1"
        },
        "U_ind": {
          "desc": "感应电路两端已测得的电压",
          "unit": "V"
        },
        "I_ind": {
          "desc": "闭合回路中的感应电流",
          "unit": "A"
        },
        "R_loop": {
          "desc": "感应电路总电阻",
          "unit": "Ω"
        }
      },
      "scenarios": {
        "线圈实验一": {
          "Uc": 4,
          "Ic": 0.2,
          "Rc": 20,
          "N": 200
        },
        "线圈实验二": {
          "Uc": 6,
          "Ic": 0.3,
          "Rc": 20,
          "N": 200
        },
        "线圈感应一": {
          "U_ind": 0.6,
          "I_ind": 0.2,
          "R_loop": 3
        },
        "线圈感应二": {
          "U_ind": 1.5,
          "I_ind": 0.3,
          "R_loop": 5
        }
      },
      "formulas": [
        {
          "name": "已知线圈电压求电流",
          "expr": "Ic = Uc/Rc",
          "when": "线圈电阻在测量期间近似不变，Uc 用 V、Rc 用 Ω。",
          "checks": [
            {
              "type": "numeric",
              "scenario": "线圈实验一",
              "expr": "Uc/Rc",
              "ref": 0.2,
              "note": "4 V÷20 Ω=0.2 A。"
            },
            {
              "type": "numeric",
              "scenario": "线圈实验二",
              "expr": "Uc/Rc",
              "ref": 0.3,
              "note": "6 V÷20 Ω=0.3 A，电压提高后电流增大。"
            },
            {
              "type": "direction",
              "scenario": "线圈实验一",
              "var": "Uc",
              "lo": 0,
              "hi": 24,
              "expr": "Uc/Rc",
              "expect": "up",
              "note": "线圈电阻固定时，提高电压会增大线圈电流。"
            },
            {
              "type": "scan",
              "scenario": "线圈实验一",
              "var": "Uc",
              "lo": 0,
              "hi": 100,
              "note": "扫描非负线圈电压，电流计算稳定。"
            },
            {
              "type": "consistency",
              "scenario": "线圈实验一",
              "expr": "Uc/Rc",
              "with": "magnet-01|由线圈电流求电压",
              "with_expr": "Ic",
              "target": "同一电磁铁线圈的电流",
              "note": "由测得电压和电阻计算电流，再与情境中的线圈电流读数核对。"
            }
          ]
        },
        {
          "name": "由线圈电流求电压",
          "expr": "Uc = Ic*Rc",
          "when": "同一线圈温度等条件稳定，电流和电阻对应一次测量。",
          "checks": [
            {
              "type": "numeric",
              "scenario": "线圈实验一",
              "expr": "Ic*Rc",
              "ref": 4,
              "note": "0.2 A×20 Ω=4 V。"
            },
            {
              "type": "numeric",
              "scenario": "线圈实验二",
              "expr": "Ic*Rc",
              "ref": 6,
              "note": "0.3 A×20 Ω=6 V。"
            },
            {
              "type": "scan",
              "scenario": "线圈实验一",
              "var": "Ic",
              "lo": 0,
              "hi": 10,
              "note": "扫描非负线圈电流，电压反算有限。"
            }
          ]
        }
      ],
      "derivation": [
        "将螺线管接入电源后，线圈中有电流并产生磁场。",
        "加入铁芯可增强电磁铁磁性；磁性还会随线圈匝数和电流等因素改变。",
        "若要比较电流影响，控制匝数和铁芯不变，只改变电流。",
        "电流可由线圈端电压和电阻通过欧姆定律求得，磁性强弱仍要实验观察。"
      ],
      "errors": [
        {
          "wrong": "把线圈电流写成电阻除以电压。",
          "wrong_expr": "Ic = Rc/Uc",
          "why": "已测得线圈两端电压和电阻后，应按欧姆定律用电压除以电阻求电流；反过来相除所得量纲不是安培。",
          "caught_by": "量纲一致性"
        },
        {
          "wrong": "把线圈电流换算成 mA 后仍把数值标成 A，导致电流大 1000 倍。",
          "wrong_expr": "Ic = 1000*Uc/Rc",
          "why": "4 V÷20 Ω=0.2 A；换成毫安是 200 mA，不能仍写作 200 A。",
          "caught_by": "数值代入",
          "trap_test": {
            "scenario": "线圈实验一",
            "expr": "1000*Uc/Rc",
            "ref": 0.2
          }
        },
        {
          "wrong": "只增加电压、同时改变线圈匝数和铁芯，还把磁性变化全归因于电流。",
          "why": "探究一个因素影响时要控制其他变量，避免把多个因素的作用混在一起。",
          "caught_by": "人工审核"
        }
      ],
      "example": {
        "stem": "某电磁铁线圈电阻为 20 Ω，接入 6 V 电源，求线圈电流。",
        "solution": [
          "Ic=Uc/Rc=6/20=0.3 A。",
          "该结果描述线圈电流，不等同于磁场强度。"
        ],
        "answer": "线圈电流为 0.3 A。"
      },
      "prereq": [
        "ohm-01"
      ],
